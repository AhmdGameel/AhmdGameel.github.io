 "projects": [
  {
   "id": "tower-health-stream",
   "name": "Tower Health Stream",
   "kind": "Streaming",
   "featured": true,
   "summary": "A streaming pipeline that watches simulated telemetry from 10,192 real Egyptian cell tower locations.",
   "problem": "Telecom teams often learn about a weak tower only after customers complain. I wanted to see how early a streaming pipeline could flag it, and whether it could tell a hardware fault from bad weather.",
   "built": "Kafka carries tower events. One Flink job validates them and routes bad records to a dead letter queue, a second classifies anomalies and rolls them up per area in 10 minute tumbling windows. A Python service adds live weather to each alert, Iceberg keeps the history, and Grafana shows it all. Airflow and dbt on DuckDB handle the batch side.",
   "result": "On a local Docker stack it kept up with 2,038 events per second and raised alerts in under 150 ms.",
   "decisions": [
    {
     "title": "Tumbling windows for regional outages",
     "body": "Fixed 10 minute buckets give one clean result per window, so an outage is never double counted and the logic stays deterministic."
    },
    {
     "title": "A dead letter queue, not a silent drop",
     "body": "Events outside the valid range go to their own topic, so bad data stays visible and can be replayed."
    },
    {
     "title": "Weather as context",
     "body": "Every alert is enriched with live Open-Meteo weather, so the team can tell a hardware fault from a storm and respond differently."
    },
    {
     "title": "Kafka in KRaft mode",
     "body": "No ZooKeeper to run, one less moving part in a local stack that already has eight services."
    }
   ],
   "next": [
    "Move the Python sinks into Flink so delivery to PostgreSQL is checkpointed.",
    "Add a schema registry so a producer change cannot break consumers.",
    "Run it on managed services with infrastructure as code."
   ],
