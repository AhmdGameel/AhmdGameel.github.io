   "id": "airflow-pyspark-etl",
   "name": "Log Analytics ETL",
   "kind": "Batch",
   "featured": true,
   "summary": "An Airflow and PySpark pipeline that turns raw web server logs into clean Parquet and reports.",
   "problem": "3.5 GB of raw access logs are hard to analyze and expensive to keep as text.",
