  {
   "id": "unified-sales-warehouse",
   "name": "Unified Sales Warehouse",
   "kind": "Warehouse",
   "featured": true,
   "summary": "A SQL Server warehouse that combines CRM and ERP sales data into one star schema.",
   "problem": "Sales data lived in two systems with different keys and formats for the same customers and products.",
   "built": "SSIS loads six raw source tables into a Bronze layer, stored procedures clean and standardize them in Silver, and Gold exposes a star schema with fact_sales, dim_customers and dim_products as views.",
   "result": "One consistent model for sales reporting, where each number can be traced back a layer at a time.",
   "decisions": [
    {
     "title": "Medallion layers",
     "body": "Bronze keeps files as they arrived, Silver applies the business rules, Gold is what analysts query."
    },
    {
     "title": "Gold as views",
     "body": "The star schema is views over Silver, so a model change needs no reload."
    },
    {
     "title": "Full reload in Silver",
     "body": "TRUNCATE and INSERT keeps the procedures simple at this size. Incremental loads are the next step."
    }
   ],
   "next": [
    "Slowly changing dimensions for customer history.",
    "Data tests on keys and row counts between layers."
   ],
