  {
   "id": "airflow-pyspark-etl",
   "name": "Log Analytics ETL",
   "kind": "Batch",
   "featured": true,
   "summary": "An Airflow and PySpark pipeline that turns 3.5 GB of raw web server logs into clean Parquet and reports.",
   "problem": "Raw access logs are slow to query and expensive to keep as text. The questions people ask of them (who is hitting us, what fails, how much is bots) need structure first.",
   "built": "Airflow DAGs split the log by date, parse each day with PySpark, join hostnames from a 258K row lookup, apply quality rules and write daily analytics reports. New files are picked up automatically.",
   "result": "10.36 million records processed end to end in about 5 minutes, and Parquet cut the data from 3.5 GB to 235 MB.",
   "decisions": [
    {
     "title": "Split by date first",
     "body": "Daily files let Spark parse days independently and let Airflow pick up a new day as soon as it lands."
    },
    {
     "title": "Columnar storage early",
     "body": "Writing Parquet right after parsing means every later stage reads 93% less data."
    },
    {
     "title": "Quality as its own stage",
     "body": "Duplicates, malformed IPs, invalid status codes and nulls are handled in one DAG, so analytics only reads clean data."
    }
   ],
   "next": [
    "Unit tests for the log parser with real sample lines.",
    "Incremental runs driven by data intervals instead of folder polling.",
    "Publish the daily reports as a small dashboard."
   ],
   "media": null,
