---
import Icon from './Icon.astro';
import { person, experience, education, certifications, skills, fmtMonth, pipelineRun } from '../lib/data';

const current = experience.find((e) => e.is_current);
const edu = education[0];
const cert = certifications[0];
const towers = pipelineRun.towers;
const illustrative = towers.source !== 'opencellid';
const core = skills.filter((s) => s.tier === 'work' || ['SQL', 'Apache Kafka', 'Apache Flink', 'Apache Airflow'].includes(s.skill)).map((s) => s.skill.replace('Apache ', ''));
const facts = [
  { k: 'Current role', v: current ? `${current.role}, ${current.company}` : person.status, s: current ? `Since ${fmtMonth(current.start_month)}, ${current.mode.toLowerCase()}` : '' },
  { k: 'Education', v: 'B.Sc. Artificial Intelligence', s: `${edu.school}, ${edu.end}, GPA ${edu.gpa}` },
  { k: 'Certified', v: `${cert.issuer} ${cert.name}`, s: `Earned ${fmtMonth(String(cert.date).slice(0, 7))}` },
  { k: 'Core stack', v: core.slice(0, 4).join(', '), s: core.slice(4, 8).join(', ') },
];
const socials = [
  { name: 'linkedin', label: 'LinkedIn', href: person.linkedin },
  { name: 'github', label: 'GitHub', href: person.github },
  { name: 'youtube', label: 'YouTube', href: person.youtube },
  { name: 'x', label: 'X', href: person.x },
] as const;
const first = person.name.split(' ')[0];
const last = person.name.split(' ').slice(1).join(' ');
const letters = (w: string, offset: number) => [...w].map((ch, i) => ({ ch, d: (offset + i) * 55 }));
---

<section id="top" class="hero night">
  <div class="grid">
    <div class="copy">
      <p class="status mono">
        <span class="dot"></span><span>{person.status}</span>
        <span class="sep" aria-hidden="true">/</span>
        <span class="clock">Cairo <time data-clock>--:--</time></span>
      </p>

      <h1 class="name" aria-label={person.name}>
        <span class="line" aria-hidden="true">{letters(first, 0).map((l) => <span class="ch" style={`--d:${l.d}ms`}>{l.ch}</span>)}</span>
        <span class="line" aria-hidden="true">{letters(last, first.length).map((l) => <span class="ch" style={`--d:${l.d}ms`}>{l.ch}</span>)}</span>
      </h1>

      <p class="role"><span class="mono tag">{person.title}</span><span class="hl">{person.headline}</span></p>
      <p class="intro">{person.intro}</p>

      <div class="cta">
        <a class="btn" href={person.cv} download><Icon name="download" size={15} /> Download resume</a>
        <a class="btn ghost" href={`mailto:${person.email}`}><Icon name="mail" size={15} /> Email me</a>
        <ul class="socials" aria-label="Profiles">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><Icon name={s.name} size={17} /></a></li>
          ))}
        </ul>
      </div>
    </div>

    <figure class="map" id="egypt" data-source={towers.source}>
      <canvas role="img" aria-label={`Map of Egypt drawn by ${towers.count.toLocaleString('en-US')} cell tower points. A live replay of the Tower Health Stream project flags anomalies as they are detected.`}></canvas>
      <div class="tip" data-tip hidden role="status"></div>

      <div class="hud-top">
        <p class="live mono"><span class="rec"></span>Live replay <span class="faint">tower-health-stream</span></p>
        <p class="mode mono">
          {illustrative ? 'Positions illustrative, real OpenCelliD export pending' : 'Positions from OpenCelliD, MCC 602'}
        </p>
        <button class="pause no-print" type="button" data-pause aria-pressed="false" aria-label="Pause the stream">
          <span class="i-pause"><Icon name="pause" size={12} /></span><span class="i-play"><Icon name="play" size={12} /></span>
        </button>
      </div>

      <div class="hud-left">
        <p class="caption panel only-rec">
          My streaming project, running in your browser. Each point is a cell tower reporting every 5 seconds.
          Problems light up the moment the rules flag them. <a href="/projects/tower-health-stream/">Case study</a>
        </p>
      <div class="hud-feed panel only-eng">
        <p class="label">Alert stream</p>
        <ol class="mono" data-ticker></ol>
        <p class="note mono">
          Port of <a href="https://github.com/AhmdGameel/tower-health-stream/blob/HEAD/simulator/tower_simulator.py" target="_blank" rel="noopener">tower_simulator.py</a>
          and the Flink SQL in <a href="https://github.com/AhmdGameel/tower-health-stream/blob/HEAD/flink_jobs/anomaly_detection.py" target="_blank" rel="noopener">anomaly_detection.py</a>.
          Events at the real rate, windows replayed 60x, peak hours on Cairo time (now <b data-stat="peak">off peak</b>).
        </p>
      </div>

      <div class="hud-stats">
        <div class="big">
          <span class="mono num" data-stat="eps">0</span>
          <span class="label">events per second</span>
        </div>
        <dl class="small mono">
          <div><dt>towers</dt><dd data-stat="towers">{towers.count.toLocaleString('en-US')}</dd></div>
          <div><dt>alerts in window</dt><dd data-stat="window-alerts">0</dd></div>
          <div class="only-eng"><dt>regional outages</dt><dd data-stat="outages">0</dd></div>
          <div class="only-eng"><dt>dead letters</dt><dd data-stat="dlq">0</dd></div>
        </dl>
        <div class="window" data-window>
          <span class="bar"></span>
          <span class="mono lbl">10 min window, closes in <b data-stat="window-left">10 min</b></span>
        </div>
      </div>

      </div>

      <figcaption class="legend mono">
        <span style="--c: var(--t-weak)">WEAK_SIGNAL <b class="only-eng" data-stat="WEAK_SIGNAL">0</b></span>
        <span style="--c: var(--t-drop)">HIGH_DROP_RATE <b class="only-eng" data-stat="HIGH_DROP_RATE">0</b></span>
        <span class="only-eng" style="--c: var(--t-latency)">HIGH_LATENCY <b data-stat="HIGH_LATENCY">0</b></span>
        <span class="only-eng" style="--c: var(--t-overload)">OVERLOADED <b data-stat="OVERLOADED">0</b></span>
        <span style="--c: var(--t-outage)">REGIONAL_OUTAGE</span>
      </figcaption>
    </figure>
  </div>

  <div class="under">
    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt class="label">{f.k}</dt>
          <dd>{f.v}<span>{f.s}</span></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--bg);
    color: var(--ink);
    padding-top: var(--head);
    overflow: hidden;
    isolation: isolate;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 50% at 72% 38%, #ffb64814 0%, transparent 70%),
      radial-gradient(40% 40% at 10% 0%, #6cc6ff0d 0%, transparent 70%);
  }
  .grid {
    position: relative;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    gap: 8px;
  }
  @media (min-width: 1040px) {
    .grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: stretch; min-height: clamp(600px, calc(100svh - var(--head) - 118px), 780px); }
  }

  .copy { position: relative; z-index: 2; padding: clamp(36px, 7vh, 72px) 0 24px; display: flex; flex-direction: column; justify-content: center; }
  .status { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 clamp(22px, 3.5vh, 34px); font-size: 11.5px; color: var(--ink-2); }
  .sep { color: var(--ink-3); }
  .clock time { color: var(--ink); font-variant-numeric: tabular-nums; }

  .name {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(54px, 7.6vw, 120px);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin: 0;
  }
  .name .line { display: block; white-space: nowrap; }
  .name .line + .line { color: transparent; -webkit-text-stroke: 1.5px var(--ink); padding-left: 0.42em; }
  .ch { display: inline-block; animation: expand 1.1s var(--ease) both; animation-delay: var(--d); }
  @keyframes expand {
    0% { opacity: 0; font-stretch: 62%; transform: translateY(0.25em); filter: blur(6px); }
    60% { opacity: 1; filter: blur(0); }
    100% { opacity: 1; font-stretch: 125%; transform: none; }
  }
  .name .line + .line .ch { animation-name: expand, fill-in; animation-duration: 1.1s, 1.4s; animation-delay: var(--d), calc(var(--d) + 900ms); animation-fill-mode: both, forwards; }
  @keyframes fill-in { to { color: var(--ink); -webkit-text-stroke-color: transparent; } }

  .role { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin: clamp(22px, 3.5vh, 32px) 0 14px; }
  .tag { font-size: 11.5px; color: var(--on-amber); background: var(--amber); padding: 6px 10px; border-radius: 999px; }
  .hl { font-size: clamp(16px, 1.4vw, 18px); color: var(--ink); font-weight: 550; }
  .intro { max-width: 50ch; font-size: clamp(16px, 1.25vw, 17.5px); color: var(--ink-2); line-height: 1.6; text-wrap: pretty; }

  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: clamp(24px, 4vh, 34px); }
  .socials { list-style: none; margin: 0 0 0 4px; padding: 0; display: flex; gap: 4px; }
  .socials a {
    width: 40px; height: 40px; display: grid; place-items: center;
    border-radius: 50%; color: var(--ink-2);
    transition: color 0.2s, background-color 0.2s;
  }
  .socials a:hover { color: var(--amber); background: var(--bg-2); }

  /* ------------------------------------------------------------- map */
  .map {
    position: relative; margin: 0;
    min-height: 460px;
    border-radius: 18px;
  }
  @media (min-width: 1040px) { .map { margin-right: calc(var(--gutter) * -1); min-height: 0; } }
  @media (max-width: 1039px) { .map { margin: 8px calc(var(--gutter) * -1) 0; border-radius: 0; } }
  .map canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
  .map:not([data-ready]) canvas { opacity: 0; }
  .map canvas { transition: opacity 1.2s ease; }

  .hud-top { position: absolute; top: 18px; left: 18px; right: 18px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; pointer-events: none; }
  .live .faint { text-transform: none; letter-spacing: 0; }
  .panel { border-radius: 14px; background: #0d0f13d9; border: 1px solid var(--line); backdrop-filter: blur(6px); }
  .caption { width: 290px; margin: 0; padding: 12px 14px; font-size: 12.5px; line-height: 1.55; color: var(--ink-2); pointer-events: auto; }
  .caption a, .note a { color: var(--amber); }
  .note { margin: 10px 0 0; padding-top: 10px; border-top: 1px solid var(--line); font-size: 9.5px; line-height: 1.65; color: var(--ink-3); pointer-events: auto; }
  .note b { color: var(--ink-2); font-weight: 500; }
  .live { display: inline-flex; align-items: center; gap: 8px; margin: 0; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
  .rec { width: 7px; height: 7px; border-radius: 50%; background: var(--alert); box-shadow: 0 0 12px var(--alert); animation: blink 1.4s infinite; }
  :global(.paused) .rec { animation: none; background: var(--ink-3); box-shadow: none; }
  @keyframes blink { 50% { opacity: 0.35; } }
  .mode { margin: 0; font-size: 10px; color: var(--ink-3); border: 1px solid var(--line-2); border-radius: 999px; padding: 4px 9px; }
  .pause {
    pointer-events: auto; margin-left: auto;
    width: 32px; height: 32px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--line-2); background: #08090cb3; color: var(--ink);
  }
  .pause:hover { border-color: var(--amber); color: var(--amber); }
  .i-play { display: none; }
  :global(.paused) .i-play { display: block; }
  :global(.paused) .i-pause { display: none; }

  .hud-left { position: absolute; left: 18px; bottom: 50px; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
  .hud-stats {
    display: grid; gap: 12px;
    padding: 14px 16px; border-radius: 14px;
    background: linear-gradient(180deg, #0d0f13cc, #0d0f13ee);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
    width: 290px;
  }
  .big { display: grid; }
  .big .num { font-size: clamp(30px, 3vw, 40px); line-height: 1; color: var(--amber); font-variant-numeric: tabular-nums; text-shadow: 0 0 24px #ffb64866; }
  .big .label { margin-top: 6px; }
  .small { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 18px; font-size: 10px; }
  .small dt { color: var(--ink-3); }
  .small dd { margin: 2px 0 0; font-size: 13px; color: var(--ink); font-variant-numeric: tabular-nums; }
  .window { display: grid; gap: 6px; }
  .window .bar { position: relative; height: 3px; border-radius: 3px; background: var(--line-2); overflow: hidden; }
  .window .bar::after { content: ''; position: absolute; inset: 0; transform-origin: left; transform: scaleX(var(--p, 0)); background: var(--amber); box-shadow: 0 0 10px var(--amber); }
  .window .lbl { font-size: 9.5px; color: var(--ink-3); }
  .window b { color: var(--ink-2); font-weight: 500; }

  .hud-feed { width: 290px; padding: 12px 14px; pointer-events: auto; }
  .hud-feed .label { margin: 0 0 8px; }
  .hud-feed ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; height: 112px; overflow: hidden; }
  .hud-feed :global(li) { display: grid; grid-template-columns: 58px 1fr; gap: 0 8px; font-size: 9.5px; color: var(--ink-2); animation: feedin 0.5s var(--ease) both; }
  .hud-feed :global(li:first-child) { color: var(--ink); }
  .hud-feed :global(.t) { color: var(--ink-3); grid-row: span 2; }
  .hud-feed :global(.ty) { color: var(--c); }
  .hud-feed :global(.tx) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @keyframes feedin { from { opacity: 0; transform: translateY(-4px); } }

  .legend {
    position: absolute; left: 18px; right: 18px; bottom: 16px;
    display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 9.5px; color: var(--ink-2);
  }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend span::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); }
  .legend b { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }

  .tip[hidden] { display: none; }
  .tip {
    position: absolute; z-index: 5; pointer-events: none;
    display: grid; gap: 2px; min-width: 200px;
    padding: 10px 12px; border-radius: 10px;
    background: #0d0f13f2; border: 1px solid var(--line-2);
    font: 10.5px/1.5 var(--mono); color: var(--ink-2);
    box-shadow: 0 20px 40px -10px #000;
  }
  .tip :global(b) { font: 600 13px var(--sans); color: var(--ink); }
  .tip :global(b span) { font: 10px var(--mono); color: var(--ink-3); margin-left: 4px; }
  .tip :global(.v) { color: var(--ink); margin-top: 4px; }
  .tip :global(.st) { color: var(--c); }
  .tip :global(i) { font-style: normal; color: var(--ink-3); margin-top: 4px; }

  @media (min-width: 1040px) and (max-height: 780px) { .hud-feed ol { height: 74px; } }
  @media (max-width: 1039px) {
    .map { display: flex; flex-direction: column; height: auto; }
    .map canvas { position: relative; inset: auto; height: min(112vw, 560px); order: 2; }
    .hud-feed ol { height: 74px; }
    .caption, .hud-feed { width: auto; }
    .hud-top { position: relative; order: 1; inset: auto; padding: 18px var(--gutter) 0; }
    .hud-left { position: relative; order: 3; inset: auto; margin: 0 var(--gutter); }
    .hud-stats { width: auto; padding: 12px 14px; }
    .legend { position: relative; order: 4; inset: auto; padding: 12px var(--gutter) 0; }
  }
  @media (max-width: 520px) {
    .small { grid-template-columns: 1fr 1fr; }
    .mode { display: none; }
  }

  /* ------------------------------------------------------------ under */
  .under {
    position: relative; z-index: 2;
    max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter) clamp(36px, 6vh, 56px);
  }
  .explain { margin: 18px 0 0; max-width: 80ch; font-size: 14px; color: var(--ink-2); }
  .explain.mono { font-size: 11.5px; line-height: 1.7; }
  .explain b { color: var(--ink); font-weight: 600; }
  .explain a { color: var(--amber); }
  .facts {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(20px, 3vh, 28px) 0 0;
    border-top: 1px solid var(--line-2);
  }
  @media (min-width: 900px) { .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .facts div { padding: 16px 18px 0 0; }
  .facts dt { margin-bottom: 6px; }
  .facts dd { margin: 0; font-weight: 600; line-height: 1.35; font-size: 15px; }
  .facts dd span { display: block; font-weight: 400; font-size: 13.5px; color: var(--ink-2); margin-top: 3px; }

  @media print {
    .map { display: none; }
    .name .line + .line { color: #000; -webkit-text-stroke: 0; }
  }
</style>

<script>
  import { startEgypt } from '../scripts/egypt';
  const map = document.getElementById('egypt');
  if (map) startEgypt(map);

  const clocks = document.querySelectorAll<HTMLTimeElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'Africa/Cairo' });
  const tick = () => clocks.forEach((c) => (c.textContent = fmt.format(new Date())));
  tick();
  setInterval(tick, 20_000);
</script>
