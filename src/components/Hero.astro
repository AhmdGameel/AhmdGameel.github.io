---
import { person, experience } from '../lib/data';

const current = experience.find((e) => e.is_current);
const stats = [
  { value: 7.3, suffix: 'M', decimals: 1, label: 'events per hour streamed', note: 'Tower Health Stream' },
  { value: 10, suffix: 'M+', decimals: 0, label: 'log records processed', note: 'Airflow and PySpark' },
  { value: 150, prefix: '<', suffix: ' ms', decimals: 0, label: 'to detect a failing tower', note: 'Kafka and Flink' },
  { value: 93, suffix: '%', decimals: 0, label: 'storage saved with Parquet', note: 'Log Analytics ETL' },
];
const chips = ['Apache Spark', 'Kafka', 'Airflow', 'AWS Glue'];
---

<section id="source" class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="copy">
        <p class="badge mono"><span class="dot"></span>{person.status}, based in {person.location}</p>

        <div class="name-box">
          <canvas id="stream" aria-hidden="true"></canvas>
          <h1 class="name" id="hero-name">
            <span class="line">Ahmed</span>
            <span class="line">Gameel</span>
          </h1>
        </div>

        <p class="role">
          <span class="serif">Data Engineer</span>
          building batch and streaming pipelines that teams can trust.
          {current && <>{' '}Currently at <strong>{current.company}</strong>, working with AWS Glue and PySpark.</>}
        </p>

        <div class="cta">
          <a class="btn" href="#gold">View my work <span aria-hidden="true">&#8595;</span></a>
          <a class="btn ghost" href="#serving">Ask my data with SQL</a>
        </div>
      </div>

      <figure class="portrait">
        <div class="arch" aria-hidden="true"></div>
        <img src="/portrait.webp" alt={`Portrait of ${person.name}`} width="589" height="726" fetchpriority="high" />
        {chips.map((c, i) => <span class:list={['float-chip', 'mono', `c${i}`]} aria-hidden="true">{c}</span>)}
      </figure>
    </div>

    <dl class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dd class="num" data-count={s.value} data-decimals={s.decimals} data-prefix={s.prefix ?? ''} data-suffix={s.suffix}>
            {s.prefix ?? ''}{s.value}{s.suffix}
          </dd>
          <dt>{s.label}<span class="mono faint">{s.note}</span></dt>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(104px, 14vh, 150px) 0 clamp(48px, 7vw, 80px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-grid { grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 clamp(22px, 3vw, 34px);
    padding: 7px 12px 7px 10px;
    font-size: 12px;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  .name-box { position: relative; }
  #stream {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
  }
  .name {
    position: relative;
    margin: 0;
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(64px, 11.2vw, 168px);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  @media (max-width: 979px) { .name { font-size: clamp(64px, 19vw, 150px); } }
  .name .line { display: block; width: max-content; }
  .name .line + .line { margin-left: 0.5em; }
  :global(html.js) .name.drawn { color: transparent; }

  .role {
    margin: clamp(24px, 3vw, 36px) 0 0;
    max-width: 36ch;
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .role .serif { font-style: italic; font-size: 1.45em; color: var(--ink); line-height: 1; margin-right: 4px; }
  .role strong { color: var(--ink); font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  /* Portrait: cutout with a white outline, standing in an arch */
  .portrait {
    position: relative;
    margin: 0 auto;
    width: min(100%, 380px);
    aspect-ratio: 0.82;
  }
  .arch {
    position: absolute;
    left: 6%; right: 6%; bottom: 0;
    height: 78%;
    border-radius: 999px 999px 18px 18px;
    background: var(--signal);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--signal) 70%, transparent);
  }
  .arch::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgb(255 255 255 / 0.35) 1.3px, transparent 1.6px) 0 0 / 12px 12px;
    mask-image: linear-gradient(to top, #000 0%, transparent 75%);
  }
  .arch::after {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: inherit;
    border: 1px solid rgb(255 255 255 / 0.35);
  }
  .portrait img {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 94%;
    height: auto;
    max-width: none;
    transform: translateX(-50%);
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.18));
  }
  .float-chip {
    position: absolute;
    z-index: 2;
    font-size: 11.5px;
    padding: 7px 11px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line-strong);
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.25);
    white-space: nowrap;
    animation: float 6s ease-in-out infinite;
  }
  .float-chip::before {
    content: '';
    display: inline-block;
    width: 6px; height: 6px;
    margin-right: 7px;
    background: var(--signal);
    vertical-align: 1px;
  }
  .c0 { left: -8%; top: 30%; }
  .c1 { right: -6%; top: 46%; animation-delay: -1.5s; }
  .c2 { left: -4%; top: 66%; animation-delay: -3s; }
  .c3 { right: -2%; top: 84%; animation-delay: -4.5s; }
  @keyframes float { 50% { transform: translateY(-8px); } }
  @media (max-width: 979px) {
    .portrait { width: min(76%, 320px); }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(56px, 8vw, 96px) 0 0;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 860px) { .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stat { padding: 20px 20px 4px 0; display: flex; flex-direction: column; gap: 6px; }
  .stat + .stat { padding-left: 20px; border-left: 1px solid var(--line); }
  @media (max-width: 859px) {
    .stats .stat:nth-child(odd) { padding-left: 0; border-left: 0; }
    .stats .stat:nth-child(n + 3) { border-top: 1px solid var(--line); margin-top: 16px; }
  }
  .num {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(40px, 4.6vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stat dt { font-size: 14px; color: var(--ink-2); display: flex; flex-direction: column; gap: 2px; }
  .stat dt span { font-size: 11px; }
</style>

<script>
  import { startStream } from '../scripts/stream';
  import { countUp } from '../scripts/count';
  startStream();
  countUp(document.querySelectorAll<HTMLElement>('#source .num'));
</script>
