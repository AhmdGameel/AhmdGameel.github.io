---
import Icon from './Icon.astro';
import { person, experience, education, certifications, fmtMonth } from '../lib/data';

const current = experience.find((e) => e.is_current);
const edu = education[0];
const cert = certifications[0];
const socials = [
  { name: 'github', label: 'GitHub', href: person.github },
  { name: 'linkedin', label: 'LinkedIn', href: person.linkedin },
  { name: 'youtube', label: 'YouTube', href: person.youtube },
  { name: 'x', label: 'X', href: person.x },
] as const;
const facts = [
  { k: 'Current role', v: current ? `${current.role}, ${current.company}` : person.status, s: current ? `Since ${fmtMonth(current.start_month)}, ${current.mode.toLowerCase()}` : '' },
  { k: 'Education', v: `B.Sc. Artificial Intelligence`, s: `${edu.school}, ${edu.end}` },
  { k: 'Certification', v: `${cert.issuer} ${cert.name}`, s: `Earned ${fmtMonth(String(cert.date).slice(0, 7))}` },
  { k: 'Location', v: person.location, s: 'Working remotely today' },
];
---

<section id="top" class="hero">
  <div class="wrap">
    <p class="badge mono reveal"><span class="dot"></span>{person.status}</p>

    <div class="name-box">
      <canvas id="stream" aria-hidden="true"></canvas>
      <h1 class="name" id="hero-name">
        <span class="line">Ahmed</span>
        <span class="line">Gameel</span>
      </h1>
    </div>

    <div class="below">
      <p class="intro reveal">
        <span class="serif role">{person.title}</span>
        {person.intro}
      </p>

      <div class="actions reveal">
        <div class="cta">
          <a class="btn" href={person.cv} download><Icon name="download" size={16} /> Download resume</a>
          <a class="btn ghost" href={`mailto:${person.email}`}><Icon name="mail" size={16} /> Email me</a>
        </div>
        <ul class="socials" aria-label="Profiles">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                <Icon name={s.name} size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <dl class="facts reveal">
      {facts.map((f) => (
        <div>
          <dt class="mono">{f.k}</dt>
          <dd>{f.v}<span>{f.s}</span></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(110px, 16vh, 160px) 0 clamp(56px, 8vw, 88px); }

  .badge {
    display: inline-flex; align-items: center; gap: 10px;
    margin: 0 0 clamp(24px, 3vw, 36px);
    padding: 7px 13px 7px 11px;
    font-size: 12px; color: var(--ink-2);
    border: 1px solid var(--line); border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  .name-box { position: relative; }
  #stream { position: absolute; left: 0; top: 0; pointer-events: none; }
  .name {
    position: relative;
    margin: 0;
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(64px, 14.5vw, 196px);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  @media (max-width: 899px) { .name { font-size: clamp(60px, 19vw, 150px); } }
  .name .line { display: block; width: max-content; }
  .name .line + .line { margin-left: 0.5em; }
  :global(html.js) .name.drawn { color: transparent; }

  .below {
    display: grid;
    gap: 28px;
    margin-top: clamp(28px, 4vw, 44px);
    align-items: end;
  }
  @media (min-width: 900px) { .below { grid-template-columns: minmax(0, 1fr) auto; gap: 48px; } }
  .intro { margin: 0; max-width: 46ch; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ink-2); }
  .role { display: block; font-size: 1.5em; font-style: italic; color: var(--ink); line-height: 1.1; margin-bottom: 6px; }

  .actions { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  @media (min-width: 900px) { .actions { align-items: flex-end; } }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .socials a {
    width: 42px; height: 42px;
    display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink-2);
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .socials a:hover { color: var(--signal); border-color: var(--signal); transform: translateY(-2px); }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(48px, 7vw, 80px) 0 0;
    border-top: 1px solid var(--line-strong);
    transition-delay: 0.1s;
  }
  @media (min-width: 900px) { .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .facts div { padding: 18px 18px 0 0; }
  .facts dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin-bottom: 6px; }
  .facts dd { margin: 0; font-weight: 600; line-height: 1.35; }
  .facts dd span { display: block; font-weight: 400; font-size: 14px; color: var(--ink-2); margin-top: 3px; }
</style>

<script>
  import { startStream } from '../scripts/stream';
  startStream();
</script>
