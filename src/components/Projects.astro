---
import Icon from './Icon.astro';
import { projects } from '../lib/data';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="projects" class="section" aria-labelledby="proj-h">
  <div class="section-head">
    <h2 id="proj-h">Projects</h2>
    <p>Three systems I built end to end: streaming, batch and a warehouse. Each case study explains the design and shows where every number comes from.</p>
  </div>

  <div class="cards">
    {featured.map((p) => (
      <article class="card reveal">
        <p class="kind label">{p.kind}</p>
        <h3><a href={`/projects/${p.id}/`}>{p.name}<Icon name="arrow" size={15} /></a></h3>
        <p class="summary">{p.summary}</p>
        <p class="result">{p.result}</p>
        <dl class="nums">
          {p.metrics.slice(0, 3).map((m) => (
            <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
          ))}
        </dl>
        <div class="stack">
          {p.stack.slice(0, 6).map((s) => <span class="chip">{s}</span>)}
          {p.stack.length > 6 && <span class="chip more">+{p.stack.length - 6}</span>}
        </div>
        <p class="links">
          <a href={`/projects/${p.id}/`}>Case study</a>
          <a href={p.repo_url} target="_blank" rel="noopener"><Icon name="github" size={14} /> Code</a>
        </p>
      </article>
    ))}
  </div>

  <h3 class="label sub">Also on GitHub</h3>
  <ul class="more">
    {rest.map((p) => (
      <li>
        <a href={p.repo_url} target="_blank" rel="noopener">
          <span class="m-name">{p.name}<Icon name="arrow" size={13} /></span>
          <span class="m-sum">{p.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .cards { display: grid; gap: 14px; }
  .card {
    position: relative;
    padding: 22px 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .card:hover { border-color: var(--line-2); box-shadow: var(--shadow); }
  .kind { margin-bottom: 6px; }
  h3 { font-size: 19px; font-weight: 650; }
  h3 a { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
  h3 a :global(svg) { color: var(--ink-3); transition: transform 0.2s, color 0.2s; }
  h3 a:hover :global(svg) { color: var(--accent); transform: translate(2px, -2px); }
  .summary { margin-top: 6px; color: var(--ink-2); }
  .result { margin-top: 8px; font-size: 15px; color: var(--ink); }
  .nums { margin: 16px 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .nums dt { font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
  .nums dd { margin: 2px 0 0; font-weight: 650; font-size: 16px; font-variant-numeric: tabular-nums; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .links { display: flex; gap: 18px; margin-top: 16px; font-size: 14px; font-weight: 550; }
  .links a { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  @media (max-width: 480px) { .nums { grid-template-columns: 1fr 1fr; } }

  .sub { margin: 36px 0 8px; font-size: 11.5px; font-weight: 400; letter-spacing: 0.06em; }
  .more { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .more a { display: grid; gap: 2px; padding: 12px 20px; margin: 0 -20px; border-radius: var(--radius); text-decoration: none; transition: background-color 0.2s; }
  .more a:hover { background: var(--card); color: inherit; }
  .m-name { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .m-name :global(svg) { color: var(--ink-3); }
  .m-sum { color: var(--ink-2); font-size: 14.5px; }
</style>
