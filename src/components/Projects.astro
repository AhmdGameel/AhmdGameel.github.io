---
import SectionHead from './SectionHead.astro';
import Topology from './Topology.astro';
import Icon from './Icon.astro';
import { projects } from '../lib/data';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="projects" class="stage">
  <div class="wrap">
    <SectionHead
      index="03"
      title="Projects"
      intro="Personal projects I built to practice batch, streaming and warehousing end to end. Each one is on GitHub with a README and setup steps."
    />

    <div class="list">
      {featured.map((p, i) => (
        <article class="card reveal">
          <div class="top">
            <div class="title-row">
              <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="serif">{p.name}</h3>
              <span class="tag mono">{p.kind}</span>
            </div>
            <p class="summary">{p.summary}</p>
          </div>

          <div class="body">
            <dl class="case">
              <div><dt class="mono">Problem</dt><dd>{p.problem}</dd></div>
              <div><dt class="mono">What I built</dt><dd>{p.built}</dd></div>
              <div><dt class="mono">Result</dt><dd>{p.result}</dd></div>
            </dl>
            <div class="side">
              <dl class="metrics">
                {p.metrics.map((m) => <div><dt class="mono">{m.label}</dt><dd>{m.value}</dd></div>)}
              </dl>
              <div class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
              <a class="repo" href={p.repo_url} target="_blank" rel="noopener">
                <Icon name="github" size={16} /> View code on GitHub
              </a>
            </div>
          </div>

          <div class="flow">
            <div class="label">How the data flows</div>
            <div class="t-h"><Topology id={p.id} nodes={p.topology} edges={p.edges} /></div>
            <div class="t-v"><Topology id={p.id} nodes={p.topology} edges={p.edges} vertical /></div>
          </div>
        </article>
      ))}
    </div>

    <div class="more reveal">
      <h3 class="label">More on GitHub</h3>
      <ul>
        {rest.map((p) => (
          <li>
            <a href={p.repo_url} target="_blank" rel="noopener">
              <span class="m-name">{p.name}</span>
              <span class="m-sum">{p.summary}</span>
              <span class="m-stack mono faint">{p.stack.join(', ')}</span>
              <span class="m-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .list { display: grid; gap: clamp(28px, 4vw, 40px); }
  .card { border: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 94%, transparent); border-radius: 6px; overflow: hidden; }
  .top { padding: clamp(20px, 3vw, 32px) clamp(20px, 3vw, 32px) 0; }
  .title-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .num { font-size: 12px; color: var(--signal); }
  .title-row h3 { margin: 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.05; font-weight: 400; }
  .tag { font-size: 11px; padding: 3px 8px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink-2); }
  .summary { margin: 10px 0 0; color: var(--ink-2); max-width: 70ch; }

  .body { display: grid; gap: 28px; padding: clamp(20px, 3vw, 32px); }
  @media (min-width: 960px) { .body { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 40px; } }
  .case { margin: 0; display: grid; gap: 16px; }
  .case dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--signal); margin-bottom: 3px; }
  .case dd { margin: 0; color: var(--ink-2); }
  .metrics {
    margin: 0 0 18px;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line); border-left: 1px solid var(--line);
  }
  .metrics div { padding: 11px 13px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .metrics dt { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .metrics dd { margin: 3px 0 0; font-weight: 600; font-size: 16px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .repo {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 600; text-decoration: none;
    border-bottom: 1px solid var(--ink); padding-bottom: 2px;
  }
  .repo:hover { color: var(--signal); border-color: var(--signal); }

  .flow {
    padding: clamp(18px, 3vw, 28px) clamp(20px, 3vw, 32px);
    border-top: 1px solid var(--line);
    background: radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 16px 16px;
    display: grid; gap: 12px;
  }
  .t-h { max-width: 940px; width: 100%; margin: 0 auto; }
  .t-v { display: none; }
  @media (max-width: 640px) { .t-h { display: none; } .t-v { display: block; max-width: 400px; margin: 0 auto; width: 100%; } }

  .more { margin-top: clamp(40px, 6vw, 56px); }
  .more h3 { margin: 0 0 10px; font-weight: 400; }
  .more ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .more a {
    display: grid; gap: 2px 24px; padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background-color 0.2s;
  }
  @media (min-width: 860px) { .more a { grid-template-columns: 220px minmax(0, 1fr) 260px 20px; align-items: baseline; } }
  .more a:hover { background: var(--paper-2); }
  .more a:hover .m-arrow { color: var(--signal); transform: translate(2px, -2px); }
  .m-name { font-weight: 600; }
  .m-sum { color: var(--ink-2); font-size: 15px; }
  .m-stack { font-size: 12px; }
  .m-arrow { color: var(--ink-3); transition: transform 0.2s, color 0.2s; }
  @media (max-width: 859px) { .m-arrow { display: none; } }
</style>
