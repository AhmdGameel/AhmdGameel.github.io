---
// Light and dark switch. Shows a moon in light mode and a sun in dark mode.
// `floating` pins it to the top right corner of the page, where people look for it.
interface Props { floating?: boolean }
const { floating = false } = Astro.props;
---

<button class:list={['theme-toggle', 'no-print', { floating }]} type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Light or dark">
  <svg class="i-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" /></svg>
  <svg class="i-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
</button>

<style>
  .theme-toggle {
    width: 38px; height: 38px; flex: none;
    display: grid; place-items: center;
    border: 0; border-radius: 10px; background: transparent;
    color: var(--ink-2); cursor: pointer;
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
  }
  .theme-toggle:hover { color: var(--ink); background: var(--bg-2); }
  .theme-toggle svg { grid-area: 1 / 1; }

  .floating {
    position: absolute; z-index: 80; top: 16px; right: 16px;
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .floating:hover { background: var(--card); border-color: var(--line-2); }
  /* Desktop: stays in the corner while the page scrolls. On phones it scrolls away, so it never sits on the contact bar. */
  @media (min-width: 1024px) { .floating { position: fixed; top: 20px; right: 20px; } }
  /* Narrow desktops have almost no right margin: tuck it closer to the corner so it clears the content. */
  @media (min-width: 1024px) and (max-width: 1199px) { .floating { top: 12px; right: 10px; width: 36px; height: 36px; } }

  .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: block; }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: block; }
    :global(:root:not([data-theme='light'])) .i-moon { display: none; }
  }
</style>
