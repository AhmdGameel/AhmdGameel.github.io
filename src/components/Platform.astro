---
import SectionHead from './SectionHead.astro';
import Topology from './Topology.astro';
import { pipelineRun as run } from '../lib/data';

const blocking = run.checks.filter((c) => c.blocking);
const warnings = run.checks.filter((c) => !c.blocking && !c.passed);
const passed = blocking.filter((c) => c.passed).length;
const tables = Object.entries(run.rows as Record<string, number>).filter(([, n]) => n > 0);
const rows = tables.reduce((a, [, n]) => a + n, 0);
const towers = run.towers;

const nodes = [
  { id: 'yaml', label: 'profile.yaml', sub: 'source of truth', x: 0, y: 0, state: 'ok' as const },
  { id: 'gh', label: 'GitHub API', sub: `${run.github.public_repos ?? 0} public repos`, x: 0, y: 1, state: 'ok' as const },
  { id: 'hist', label: 'Live site', sub: 'previous runs', x: 0, y: 2, state: 'ok' as const },
  { id: 'tw', label: 'Tower layer', sub: towers.source === 'opencellid' ? 'OpenCelliD' : 'illustrative', x: 0, y: 3, state: towers.source === 'opencellid' ? ('ok' as const) : ('warn' as const) },
  { id: 'tr', label: 'Transform', sub: 'lineage', x: 1, y: 1.5, state: 'ok' as const },
  { id: 'qg', label: 'Quality gate', sub: `${passed}/${blocking.length}, ${warnings.length} warn`, x: 2, y: 1.5, state: warnings.length ? ('warn' as const) : ('ok' as const) },
  { id: 'pq', label: 'Parquet', sub: `${tables.length} tables`, x: 3, y: 0.5, state: 'ok' as const },
  { id: 'js', label: 'JSON', sub: 'site data', x: 3, y: 1.5, state: 'ok' as const },
  { id: 'bin', label: 'towers.bin', sub: `${towers.count.toLocaleString('en-US')} points`, x: 3, y: 2.5, state: 'ok' as const },
  { id: 'astro', label: 'Astro build', sub: 'static pages', x: 4, y: 1.5, state: 'ok' as const },
  { id: 'copy', label: 'Copy check', sub: 'style rules', x: 5, y: 1.5, state: 'ok' as const },
  { id: 'pages', label: 'GitHub Pages', sub: 'you are here', x: 6, y: 1.5, state: 'ok' as const },
];
const edges: [string, string][] = [
  ['yaml', 'tr'], ['gh', 'tr'], ['hist', 'tr'], ['tw', 'tr'], ['tr', 'qg'],
  ['qg', 'pq'], ['qg', 'js'], ['qg', 'bin'], ['pq', 'astro'], ['js', 'astro'], ['bin', 'astro'], ['astro', 'copy'], ['copy', 'pages'],
];

const history = (run.history ?? []).slice(-40);
const maxMs = Math.max(1, ...history.map((h) => h.duration_ms));
const HW = 600, HH = 90, bw = HW / Math.max(history.length, 12);

const presets = [
  { label: 'Where did I use Kafka?', sql: "SELECT skill, evidence, kind\nFROM skill_evidence\nWHERE skill = 'Apache Kafka';" },
  { label: 'Skills by evidence', sql: "SELECT tier, count(*) AS skills,\n       string_agg(skill, ', ') AS which\nFROM skills\nGROUP BY tier\nORDER BY min(CASE tier WHEN 'work' THEN 0 WHEN 'built' THEN 1 WHEN 'trained' THEN 2 ELSE 3 END);" },
  { label: 'Where every number comes from', sql: 'SELECT project, label, value, kind, source\nFROM metric_lineage\nORDER BY project;' },
  { label: 'Quality checks of this build', sql: 'SELECT name, passed, blocking, detail\nFROM quality_checks\nORDER BY passed, blocking DESC;' },
  { label: 'Pipeline runs', sql: "SELECT started_at, duration_ms,\n       checks_passed || '/' || checks_total AS checks, trigger\nFROM runs\nORDER BY started_at DESC\nLIMIT 10;" },
  { label: 'Work and training', sql: "SELECT type, role, company, start_month,\n       coalesce(end_month, 'present') AS end_month\nFROM experience\nORDER BY start_month DESC;" },
  ...(tables.some(([t]) => t === 'towers') ? [{ label: 'Real towers by operator', sql: "SELECT operator,\n       count(*) AS towers,\n       round(100 * count(*) FILTER (radio = 'LTE') / count(*), 1) AS lte_pct\nFROM towers\nGROUP BY operator\nORDER BY towers DESC;" }] : []),
  ...(tables.some(([t]) => t === 'dbt_regional_risk_index') ? [{ label: 'Riskiest areas (dbt)', sql: 'SELECT area, total_towers, lte_coverage_pct, risk_level\nFROM dbt_regional_risk_index\nWHERE risk_level = \'HIGH\'\nORDER BY total_towers DESC\nLIMIT 10;' }] : []),
  ...(tables.some(([t]) => t === 'dbt_operator_performance') ? [{ label: 'dbt vs raw, reconciled', sql: 'SELECT d.operator, d.total_towers AS dbt_towers, r.raw_towers,\n       d.total_towers = r.raw_towers AS match\nFROM dbt_operator_performance d\nJOIN (SELECT operator, count(*) AS raw_towers\n      FROM towers GROUP BY operator) r USING (operator)\nORDER BY dbt_towers DESC;' }] : []),
];
---

<section id="platform" class="stage">
  <div class="wrap">
    <SectionHead
      index="04"
      kicker="Platform"
      title="This site is a <em>data pipeline</em>"
      intro={`Every morning a GitHub Action extracts my profile and GitHub activity, links each skill to its evidence and each number to its source, then runs ${blocking.length} blocking checks. If one fails, nothing ships. You are reading its output.`}
    />

    <div class="board reveal" data-started={run.started_at}>
      <div class="tile">
        <p class="label">Last run</p>
        <p class="v" data-ago>{new Date(run.started_at).toUTCString().slice(5, 22)} UTC</p>
        <p class="s mono">run {run.run_id}, {run.duration_ms} ms, {run.trigger}</p>
      </div>
      <div class="tile" data-fresh>
        <p class="label">Freshness</p>
        <p class="v"><span class="led"></span><span data-fresh-text>within SLA</span></p>
        <p class="s mono">SLA 26 h, checked in your browser</p>
      </div>
      <div class="tile">
        <p class="label">Quality gate</p>
        <p class="v">{passed}/{blocking.length} <span class="faint unit">passed</span></p>
        <p class="s mono">{warnings.length ? `${warnings.length} warning${warnings.length > 1 ? 's' : ''}, not blocking` : 'no warnings'}</p>
      </div>
      <div class="tile">
        <p class="label">Published</p>
        <p class="v">{rows.toLocaleString('en-US')} <span class="faint unit">rows</span></p>
        <p class="s mono">{tables.length} Parquet tables + {towers.count.toLocaleString('en-US')} towers</p>
      </div>
    </div>

    <div class="dag reveal">
      <div class="t-h"><Topology id="site" nodes={nodes} edges={edges} nw={118} /></div>
      <div class="t-v"><Topology id="site" nodes={nodes.map((n) => ({ ...n, x: n.x, y: n.y }))} edges={edges} vertical nw={118} /></div>
    </div>

    <p class="teaser only-rec reveal">
      Engineers can inspect the checks, the run history and query the published tables with SQL.
      <button type="button" class="btn small" data-to-engineer>Open the engineer view</button>
    </p>

    <div class="eng only-eng">
      <div class="two">
        <div class="panel reveal">
          <p class="label">Run history, duration per run</p>
          <svg class="hist" viewBox={`0 0 ${HW} ${HH + 16}`} role="img" aria-label={`${history.length} recorded runs`}>
            {history.map((h, i) => {
              const hgt = Math.max(3, (h.duration_ms / maxMs) * HH);
              const ok = h.checks_passed === h.checks_total;
              return (
                <rect x={i * bw + 2} y={HH - hgt} width={Math.max(2, bw - 4)} height={hgt} rx="2" class:list={[ok ? 'ok' : 'bad']}>
                  <title>{`${h.started_at}: ${h.duration_ms} ms, ${h.checks_passed}/${h.checks_total} blocking checks passed, ${h.trigger}`}</title>
                </rect>
              );
            })}
            <line x1="0" x2={HW} y1={HH + 0.5} y2={HH + 0.5} />
            <text x="0" y={HH + 13}>{history.length} run{history.length === 1 ? '' : 's'} recorded, history kept on the live site</text>
          </svg>
        </div>
        <div class="panel reveal">
          <p class="label">Checks in this build</p>
          <ul class="checks mono">
            {run.checks.map((c) => (
              <li class:list={[c.passed ? 'pass' : c.blocking ? 'fail' : 'warn']}>
                <span class="st">{c.passed ? 'PASS' : c.blocking ? 'FAIL' : 'WARN'}</span>
                <span class="nm">{c.name}</span>
                {!c.passed && c.detail && <span class="dt">{c.detail}</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="console reveal" id="console" data-tables={JSON.stringify(tables.map(([t]) => t))}>
        <aside class="schema">
          <div class="label">Tables</div>
          <ul>
            {tables.map(([t, n]) => (
              <li>
                <button type="button" class="tbl mono" data-table={t}><span>{t}</span><span class="faint">{n}</span></button>
                <div class="cols mono faint" data-cols={t}></div>
              </li>
            ))}
          </ul>
          <p class="hint mono faint">Click a table to preview it. Download any of them as Parquet from /data/name.parquet.</p>
        </aside>
        <div class="main">
          <div class="presets">
            {presets.map((p, i) => <button type="button" class:list={['preset', 'mono', i === 0 && 'active']} data-sql={p.sql}>{p.label}</button>)}
          </div>
          <div class="editor">
            <pre class="hl mono" aria-hidden="true"><code id="sql-hl"></code></pre>
            <textarea id="sql" class="mono" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="SQL query">{presets[0].sql}</textarea>
          </div>
          <div class="bar">
            <div class="status mono" aria-live="polite"><span class="state-dot" data-state="cold"></span><span id="sql-state">DuckDB loads on your first query, about 7 MB, once</span></div>
            <button class="btn" id="sql-run" type="button">Run <span class="kbd">Ctrl Enter</span></button>
          </div>
          <div class="results" id="sql-results"><p class="empty mono faint">Results show up here.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .board { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (min-width: 900px) { .board { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tile { padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-1); display: grid; gap: 6px; }
  .tile .v { font-family: var(--display); font-stretch: 108%; font-weight: 750; font-size: clamp(19px, 2vw, 25px); letter-spacing: -0.02em; display: flex; align-items: center; gap: 10px; }
  .tile .s { font-size: 10px; color: var(--ink-3); }
  .unit { font-size: 0.6em; font-family: var(--sans); font-weight: 400; letter-spacing: 0; }
  .led { width: 10px; height: 10px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 12px var(--ok); flex: none; }
  [data-fresh].stale .led { background: var(--alert); box-shadow: 0 0 12px var(--alert); }
  [data-fresh].stale .v { color: var(--alert); }

  .dag { margin-top: 14px; padding: 26px; border: 1px solid var(--line); border-radius: var(--radius); background: radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 18px 18px; }
  .t-v { display: none; }
  @media (max-width: 760px) { .t-h { display: none; } .t-v { display: block; max-width: 380px; margin: 0 auto; } }

  .teaser { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; color: var(--ink-2); }

  .two { display: grid; gap: 14px; margin-top: 14px; }
  @media (min-width: 960px) { .two { grid-template-columns: 1fr 1fr; } }
  .panel { padding: 20px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-1); }
  .hist { width: 100%; height: auto; margin-top: 14px; }
  .hist rect.ok { fill: var(--amber); }
  .hist rect.bad { fill: var(--alert); }
  .hist line { stroke: var(--line-2); }
  .hist text { font: 9px var(--mono); fill: var(--ink-3); }
  .checks { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 6px; font-size: 11px; max-height: 360px; overflow: auto; }
  .checks li { display: grid; grid-template-columns: 42px 1fr; gap: 2px 10px; }
  .checks .st { color: var(--ok); }
  .checks .warn .st { color: var(--amber); }
  .checks .fail .st { color: var(--alert); }
  .checks .dt { grid-column: 2; color: var(--ink-3); font-size: 10px; }

  .console { margin-top: 14px; display: grid; border: 1px solid var(--line-2); border-radius: var(--radius); background: var(--bg-1); min-width: 0; overflow: hidden; }
  @media (min-width: 960px) { .console { grid-template-columns: 230px minmax(0, 1fr); } }
  .schema { padding: 16px; border-bottom: 1px solid var(--line); }
  @media (min-width: 960px) { .schema { border-bottom: 0; border-right: 1px solid var(--line); } }
  .schema ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 2px; }
  @media (max-width: 959px) { .schema ul { display: flex; flex-wrap: wrap; gap: 6px; } .cols, .hint { display: none !important; } }
  .tbl { display: flex; justify-content: space-between; gap: 10px; width: 100%; padding: 6px 8px; border: 1px solid transparent; background: transparent; font-size: 11px; cursor: pointer; border-radius: 6px; text-align: left; }
  @media (max-width: 959px) { .tbl { border-color: var(--line); } }
  .tbl:hover { border-color: var(--line-2); color: var(--amber); }
  .cols { font-size: 10px; padding: 0 8px 6px 16px; line-height: 1.8; display: none; }
  .cols.open { display: block; }
  .hint { font-size: 10px; margin: 14px 0 0; line-height: 1.6; }

  .main { padding: 16px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .presets { display: flex; flex-wrap: wrap; gap: 6px; }
  .preset { font-size: 10.5px; padding: 7px 11px; border: 1px solid var(--line-2); background: transparent; border-radius: 999px; cursor: pointer; color: var(--ink-2); }
  .preset:hover { border-color: var(--amber); color: var(--amber); }
  .preset.active { background: var(--amber); color: var(--on-amber); border-color: var(--amber); }
  .editor { position: relative; border: 1px solid var(--line); background: var(--bg); border-radius: 8px; }
  .editor:focus-within { border-color: var(--amber); }
  .hl, textarea { margin: 0; padding: 16px; font-size: 12.5px; line-height: 1.7; white-space: pre-wrap; word-break: break-word; tab-size: 2; font-family: var(--mono); letter-spacing: 0; }
  .hl { pointer-events: none; color: var(--ink); min-height: 150px; }
  textarea { position: absolute; inset: 0; width: 100%; height: 100%; resize: none; border: 0; background: transparent; color: transparent; caret-color: var(--amber); outline: none; overflow: hidden; }
  :global(.tok-k) { color: var(--amber); }
  :global(.tok-s) { color: var(--ok); }
  :global(.tok-n) { color: var(--nile); }
  :global(.tok-c) { color: var(--ink-3); }
  :global(.tok-f) { color: var(--ink-2); font-style: italic; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .status { display: inline-flex; align-items: center; gap: 8px; font-size: 10.5px; color: var(--ink-2); }
  .state-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); flex: none; }
  .state-dot[data-state='loading'] { background: var(--amber); animation: pulse 1s infinite; }
  .state-dot[data-state='ready'] { background: var(--ok); }
  .state-dot[data-state='error'] { background: var(--alert); }
  .kbd { font-size: 9.5px; opacity: 0.7; border: 1px solid currentColor; border-radius: 4px; padding: 1px 5px; }
  @media (hover: none) { .kbd { display: none; } }
  .results { border: 1px solid var(--line); border-radius: 8px; max-height: 380px; overflow: auto; min-height: 120px; }
  .empty { margin: 0; padding: 20px; font-size: 11px; }
  .results :global(table) { border-collapse: collapse; width: 100%; font-size: 13px; }
  .results :global(th) { position: sticky; top: 0; background: var(--bg-2); text-align: left; font-family: var(--mono); font-weight: 400; font-size: 10px; color: var(--ink-3); padding: 9px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .results :global(th small) { display: block; opacity: 0.7; font-size: 9px; }
  .results :global(td) { padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .results :global(td.num) { font-family: var(--mono); font-size: 12px; text-align: right; font-variant-numeric: tabular-nums; }
  .results :global(td.null) { color: var(--ink-3); font-family: var(--mono); font-size: 11px; }
  .results :global(.err) { margin: 0; padding: 16px; color: var(--alert); font-family: var(--mono); font-size: 11px; white-space: pre-wrap; }
  .results :global(tr.fresh td) { animation: rowin 0.5s ease both; }
  @keyframes rowin { from { background: var(--amber-soft); } to { background: transparent; } }
</style>

<script>
  import { initConsole } from '../scripts/query';
  initConsole();

  // Freshness is judged by the visitor's clock, so a stalled cron shows up here.
  const board = document.querySelector<HTMLElement>('#platform .board');
  if (board) {
    const started = new Date(board.dataset.started!).getTime();
    const hours = (Date.now() - started) / 36e5;
    const ago = board.querySelector('[data-ago]');
    if (ago) ago.textContent = hours < 1 ? `${Math.max(1, Math.round(hours * 60))} min ago` : hours < 48 ? `${Math.round(hours)} h ago` : `${Math.round(hours / 24)} days ago`;
    const fresh = board.querySelector<HTMLElement>('[data-fresh]');
    if (fresh && hours > 26) {
      fresh.classList.add('stale');
      const t = fresh.querySelector('[data-fresh-text]');
      if (t) t.textContent = 'stale, the daily run missed';
    }
  }
  document.querySelectorAll('[data-to-engineer]').forEach((b) =>
    b.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('setlens', { detail: 'engineer' }));
      document.getElementById('platform')?.scrollIntoView({ behavior: 'smooth' });
    }),
  );
</script>
