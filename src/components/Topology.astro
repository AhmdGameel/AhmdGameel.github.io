---
import type { TopoNode } from '../lib/data';

interface Props { id: string; nodes: TopoNode[]; edges: [string, string][]; vertical?: boolean }
const { id, nodes, edges, vertical = false } = Astro.props;

const NW = 124, NH = 46, GX = vertical ? 150 : 152, GY = vertical ? 92 : 74, PAD = 8;
const pos = (n: TopoNode) => (vertical ? { c: n.y, r: n.x } : { c: n.x, r: n.y });
const maxC = Math.max(...nodes.map((n) => pos(n).c));
const maxR = Math.max(...nodes.map((n) => pos(n).r));
const W = maxC * GX + NW + PAD * 2;
const H = maxR * GY + NH + PAD * 2;
const box = (n: TopoNode) => ({ x: PAD + pos(n).c * GX, y: PAD + pos(n).r * GY });
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

const paths = edges.map(([a, b], i) => {
  const A = box(byId[a]), B = box(byId[b]);
  let d: string;
  if (vertical) {
    const x1 = A.x + NW / 2, y1 = A.y + NH, x2 = B.x + NW / 2, y2 = B.y;
    const my = (y1 + y2) / 2;
    d = `M${x1},${y1} C${x1},${my} ${x2},${my} ${x2},${y2}`;
  } else {
    const x1 = A.x + NW, y1 = A.y + NH / 2, x2 = B.x, y2 = B.y + NH / 2;
    const mx = (x1 + x2) / 2;
    d = `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
  }
  return { d, key: `${id}-${vertical ? 'v' : 'h'}-${i}`, dur: 1.6 + ((i * 37) % 10) / 10 };
});
---

<svg class:list={['topo', vertical ? 'v' : 'h']} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Architecture: ${nodes.map((n) => n.label).join(', ')}`}>
  {paths.map((p) => <path id={p.key} d={p.d} class="edge" />)}
  {paths.map((p, i) => (
    <g class="packets">
      <circle r="3"><animateMotion dur={`${p.dur}s`} repeatCount="indefinite" begin={`${(i % 4) * 0.35}s`}><mpath href={`#${p.key}`} /></animateMotion></circle>
      <circle r="2" class="trail"><animateMotion dur={`${p.dur}s`} repeatCount="indefinite" begin={`${(i % 4) * 0.35 + p.dur / 2}s`}><mpath href={`#${p.key}`} /></animateMotion></circle>
    </g>
  ))}
  {nodes.map((n) => {
    const b = box(n);
    return (
      <g class="node" transform={`translate(${b.x},${b.y})`}>
        <rect width={NW} height={NH} rx="3" />
        <text x="12" y="20" class="nl">{n.label}</text>
        <text x="12" y="35" class="ns">{n.sub}</text>
      </g>
    );
  })}
</svg>

<style>
  .topo { width: 100%; height: auto; overflow: visible; }
  .edge { fill: none; stroke: var(--line-strong); stroke-width: 1.2; }
  .packets circle { fill: var(--signal); }
  .packets .trail { fill: var(--ink-3); }
  .node rect { fill: var(--paper); stroke: var(--line-strong); stroke-width: 1; transition: stroke 0.2s; }
  .node:hover rect { stroke: var(--signal); }
  .nl { font: 600 12.5px var(--sans); fill: var(--ink); }
  .ns { font: 10.5px var(--mono); fill: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) { .packets { display: none; } }
</style>
