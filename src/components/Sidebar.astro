---
import Icon from './Icon.astro';
import { person, experience, education, certifications, fmtMonth, whatsapp } from '../lib/data';

const current = experience.find((e) => e.is_current);
const edu = education[0];
const cert = certifications[0];
const nav = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
const socials = [
  { name: 'linkedin', label: 'LinkedIn', href: person.linkedin },
  { name: 'github', label: 'GitHub', href: person.github },
  { name: 'youtube', label: 'YouTube', href: person.youtube },
  { name: 'x', label: 'X', href: person.x },
] as const;
---

<a class="skip" href="#content">Skip to content</a>

<header class="side" id="top">
  <div class="inner">
    <div class="id">
      <img class="photo" src={person.photo} width="112" height="112" alt={`Photo of ${person.name}`} decoding="async" fetchpriority="high" />
      <h1>{person.name}</h1>
      <p class="role">{person.title}</p>
      <p class="pitch">{person.intro}</p>
      <p class="status"><span class="dot"></span>{person.status}</p>
      <div class="cta" id="cta">
        <a class="btn" href={`mailto:${person.email}`}><Icon name="mail" size={16} /> Email me</a>
        <a class="btn ghost wa" href={whatsapp.url()} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> WhatsApp</a>
        <a class="btn ghost" href={person.cv} download><Icon name="download" size={16} /> Resume</a>
      </div>
      <div class="links no-print">
        <ul class="socials" aria-label="Profiles">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><Icon name={s.name} size={18} /></a></li>
          ))}
        </ul>
      </div>
    </div>

    <dl class="facts">
      {current && (
        <div><dt>Now</dt><dd>{current.role} at {current.company}<span>Since {fmtMonth(current.start_month)}, {current.mode.toLowerCase()}</span></dd></div>
      )}
      <div><dt>Based in</dt><dd>{person.location}<span>Local time <time data-clock>--:--</time></span></dd></div>
      <div><dt>Work mode</dt><dd>{person.availability}<span>{person.availability_note}</span></dd></div>
      <div><dt>Degree</dt><dd>B.Sc. Artificial Intelligence<span>{edu.school}, {edu.end}</span></dd></div>
      <div><dt>Certified</dt><dd>{cert.issuer} {cert.name}<span>{fmtMonth(String(cert.date).slice(0, 7))}</span></dd></div>
    </dl>

    <nav class="nav no-print" aria-label="Sections">
      <ul>
        {nav.map((n) => (
          <li><a href={`#${n.id}`} data-nav={n.id}><span class="line" aria-hidden="true"></span>{n.label}</a></li>
        ))}
      </ul>
    </nav>

  </div>
</header>

<div class="mbar no-print" id="mbar" aria-hidden="true">
  <img class="mphoto" src={person.photo} width="34" height="34" alt="" loading="lazy" decoding="async" />
  <span class="mname">{person.name}<small>{person.title}</small></span>
  <a class="btn small" href={`mailto:${person.email}`} tabindex="-1">Email</a>
  <a class="btn small ghost wa icon" href={whatsapp.url()} target="_blank" rel="noopener" tabindex="-1" aria-label="WhatsApp" title="WhatsApp"><Icon name="whatsapp" size={16} /></a>
  <a class="btn small ghost" href={person.cv} download tabindex="-1">Resume</a>
</div>

<style>
  .skip {
    position: fixed; left: 12px; top: -60px; z-index: 200;
    background: var(--accent); color: var(--on-accent);
    padding: 10px 14px; border-radius: 8px; text-decoration: none; font-size: 14px;
  }
  .skip:focus { top: 12px; }

  .side { padding: clamp(48px, 8vw, 72px) 0 40px; }
  .inner { display: flex; flex-direction: column; gap: 32px; }
  @media (min-width: 1024px) {
    /* The column scrolls on its own, which clips anything drawn past its edges. The side padding,
       taken back with a negative margin, leaves room for the photo ring and the status dot. */
    .side { position: sticky; top: 0; max-height: 100vh; max-height: 100dvh; overflow-y: auto; scrollbar-width: none; margin-inline: -16px; padding: 64px 16px 32px; }
    .side::-webkit-scrollbar { display: none; }
    .inner { gap: 26px; }
  }

  .photo {
    width: 112px; height: 112px; margin-bottom: 22px;
    border-radius: 50%; object-fit: cover; background: #eaeff7;
    box-shadow: 0 0 0 4px var(--card), 0 0 0 5px var(--line), var(--shadow);
  }
  /* Short laptop screens: keep the identity, contact and facts in view without scrolling the column.
     The pitch repeats the first About paragraph, which is visible next to it. */
  @media (min-width: 1024px) and (max-height: 820px) {
    .side { padding: 40px 16px 24px; }
    .photo { width: 88px; height: 88px; margin-bottom: 18px; }
    .pitch { display: none; }
  }
  @media (min-width: 1024px) and (max-height: 700px) {
    .side { padding: 32px 16px 20px; }
    .inner { gap: 20px; }
    .photo { width: 72px; height: 72px; margin-bottom: 14px; }
    .status { margin-top: 14px; }
    .cta { margin-top: 16px; }
    .links { margin-top: 10px; }
  }
  h1 { font-size: clamp(34px, 4vw, 44px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
  .role { margin-top: 8px; font-size: 19px; font-weight: 550; color: var(--ink); }
  .pitch { margin-top: 14px; max-width: 38ch; color: var(--ink-2); font-size: 15.5px; }
  .status { display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; font-size: 14px; color: var(--ink-2); }
  .cta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  @media (max-width: 1023px) {
    .cta { display: grid; grid-template-columns: 1fr 1fr; max-width: 420px; }
    .cta .btn:first-child { grid-column: 1 / -1; }
  }
  .wa :global(svg) { color: #1ea952; }

  .facts { margin: 0; display: grid; gap: 10px; padding-top: 20px; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 78px 1fr; gap: 12px; align-items: baseline; }
  .facts dt { font-family: var(--mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); }
  .facts dd { margin: 0; font-size: 14px; font-weight: 550; line-height: 1.4; }
  .facts dd span { display: block; font-weight: 400; color: var(--ink-3); font-size: 13px; }
  .facts time { font-variant-numeric: tabular-nums; }

  .nav { display: none; }
  @media (min-width: 1024px) and (min-height: 1110px) { .nav { display: block; } }
  .nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .nav a {
    display: inline-flex; align-items: center; gap: 14px;
    padding: 5px 0; font-size: 13px; font-weight: 550; letter-spacing: 0.02em;
    color: var(--ink-3); text-decoration: none; transition: color 0.2s;
  }
  .line { width: 24px; height: 1px; background: var(--ink-3); transition: width 0.25s var(--ease), background-color 0.2s; }
  .nav a:hover, .nav a.active { color: var(--ink); }
  .nav a:hover .line, .nav a.active .line { width: 56px; background: var(--ink); }

  .links { display: flex; align-items: center; gap: 4px; margin-top: 14px; margin-left: -9px; }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  .socials a {
    width: 38px; height: 38px; display: grid; place-items: center;
    border-radius: 8px; color: var(--ink-3); border: 0; background: transparent; cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .socials a:hover { color: var(--ink); background: var(--bg-2); }

  /* Mobile: once the buttons scroll away, keep contact one tap away. */
  .mbar {
    position: fixed; z-index: 90; left: 0; right: 0; top: 0;
    display: flex; align-items: center; gap: 8px;
    padding: 10px var(--gutter);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 6px 20px -14px #11131866;
    transform: translateY(-100%); transition: transform 0.25s var(--ease);
  }
  .mbar.show { transform: none; }
  .mphoto { width: 34px; height: 34px; border-radius: 50%; background: #eaeff7; flex: none; }
  .mbar .icon { padding: 7px 9px; }
  @media (max-width: 379px) { .mphoto { display: none; } }
  .mname { margin-right: auto; white-space: nowrap; display: grid; font-weight: 650; font-size: 14px; line-height: 1.2; }
  .mname small { font-weight: 400; font-size: 12px; color: var(--ink-3); }
  @media (min-width: 1024px) { .mbar { display: none; } }
</style>

<script>
  // Local time in Cairo, so recruiters in other time zones know when to call.
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'Africa/Cairo' });
  const tick = () => document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((c) => (c.textContent = fmt.format(new Date())));
  tick();
  setInterval(tick, 20_000);

  // Highlight the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = links.map((l) => document.getElementById(l.dataset.nav!)).filter(Boolean) as HTMLElement[];
  const onScroll = () => {
    let active = sections[0]?.id ?? '';
    for (const s of sections) if (s.getBoundingClientRect().top <= innerHeight * 0.3) active = s.id;
    links.forEach((l) => l.classList.toggle('active', l.dataset.nav === active));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile contact bar appears once the main buttons are off screen.
  const bar = document.getElementById('mbar');
  const cta = document.getElementById('cta');
  if (bar && cta) {
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting && e.boundingClientRect.top < 0;
      bar.classList.toggle('show', show);
      bar.setAttribute('aria-hidden', String(!show));
      bar.querySelectorAll('a').forEach((a) => (a.tabIndex = show ? 0 : -1));
    }).observe(cta);
  }
</script>
