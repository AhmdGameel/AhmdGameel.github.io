---
import SectionHead from './SectionHead.astro';
import { person } from '../lib/data';
---

<section id="about" class="stage">
  <div class="wrap grid">
    <SectionHead index="01" title="About" />
    <div class="text reveal">
      {person.about.map((p: string, i: number) => <p class:list={[i === 0 && 'lead']}>{p}</p>)}
      <p class="community mono"><span class="dot-sq"></span>{person.community}</p>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 8px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 280px minmax(0, 1fr); gap: 48px; } }
  .text { max-width: 64ch; }
  .text p { margin: 0 0 18px; color: var(--ink-2); font-size: 17px; }
  .text .lead { font-family: var(--serif); font-size: clamp(24px, 2.4vw, 30px); line-height: 1.25; color: var(--ink); }
  .community { display: inline-flex; align-items: center; gap: 10px; font-size: 13px !important; margin-top: 8px !important; }
  .dot-sq { width: 8px; height: 8px; background: var(--signal); display: inline-block; }
</style>
