---
import SectionHead from './SectionHead.astro';
import { person, experience, education, certifications, skills } from '../lib/data';

const current = experience.find((e) => e.is_current);
const edu = education[0];
const facts: [string, string][] = [
  ['currently', current ? `${current.role} at ${current.company} (${current.mode})` : person.status],
  ['studying', `${edu.degree}, ${edu.school}, GPA ${edu.gpa}, class of ${edu.end}`],
  ['certified', `${certifications[0].name} (${certifications[0].issuer})`],
  ['community', person.community],
  ['based in', person.location],
  ['status', person.status],
];

const groups = [...new Set(skills.map((s) => s.group))];
const raw = JSON.stringify(
  {
    name: person.name,
    title: person.title,
    location: person.location,
    current_role: current && { company: current.company, since: current.start_month },
    education: { degree: edu.degree, school: edu.school, gpa: edu.gpa },
    certifications: certifications.map((c) => c.name),
    links: { github: person.github, linkedin: person.linkedin },
  },
  null,
  2,
);
---

<section id="bronze" class="stage">
  <div class="wrap">
    <SectionHead index="01" table="bronze.raw_profile" meta="1 row, 7 columns, ingested from cv.pdf">
      A person, <em>before</em> the transform.
    </SectionHead>

    <div class="grid">
      <figure class="portrait reveal">
        <div class="frame" tabindex="0" aria-label="Portrait of Ahmed Gameel. Hover or focus to reveal the full image.">
          <img src="/ahmed.jpg" alt="Ahmed Gameel" width="256" height="256" loading="lazy" />
          <canvas id="dither" aria-hidden="true"></canvas>
        </div>
        <figcaption class="mono faint">
          <span>photo.bin</span><span>hover to decode</span>
        </figcaption>
      </figure>

      <div class="record reveal">
        <div class="toggle mono" role="tablist" aria-label="Record view">
          <button role="tab" aria-selected="true" data-view="parsed">parsed</button>
          <button role="tab" aria-selected="false" data-view="raw">raw json</button>
        </div>

        <div class="view parsed" data-panel="parsed">
          <p class="summary">{person.tagline}</p>
          <p class="body">{person.summary}</p>
          <dl class="facts">
            {facts.map(([k, v]) => (
              <div><dt class="mono">{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </div>
        <pre class="view raw mono" data-panel="raw" hidden>{raw}</pre>
      </div>
    </div>

    <div class="schema reveal">
      <div class="schema-head mono">
        <span>DESCRIBE ahmed.skills</span>
        <span class="faint">{skills.length} rows</span>
      </div>
      <div class="schema-grid">
        {groups.map((g) => (
          <div class="group">
            <div class="gname mono">{g}</div>
            <ul>
              {skills.filter((s) => s.group === g).map((s) => (
                <li>
                  <span>{s.name}</span>
                  <span class="meter" aria-label={`level ${s.level} of 5`}>
                    {[1, 2, 3, 4, 5].map((i) => <i class={i <= s.level ? 'on' : ''}></i>)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (min-width: 880px) { .grid { grid-template-columns: minmax(240px, 360px) 1fr; } }

  .portrait { margin: 0; }
  .frame {
    position: relative;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    background: var(--paper-2);
    overflow: hidden;
    cursor: crosshair;
    max-width: 360px;
  }
  .frame img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: grayscale(1) contrast(1.05);
    transition: opacity 0.5s ease, filter 0.8s ease;
  }
  .frame canvas { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity 0.5s ease; }
  .frame:hover img, .frame:focus-visible img, .frame.open img { opacity: 1; filter: none; }
  .frame:hover canvas, .frame:focus-visible canvas, .frame.open canvas { opacity: 0; }
  :global(html:not(.js)) .frame img { opacity: 1; }
  figcaption { display: flex; justify-content: space-between; max-width: 360px; margin-top: 10px; font-size: 11px; }

  .toggle { display: inline-flex; border: 1px solid var(--line); border-radius: var(--radius); padding: 3px; margin-bottom: 28px; }
  .toggle button {
    border: 0; background: transparent; padding: 6px 12px; font-size: 12px; cursor: pointer; border-radius: 2px; color: var(--ink-2);
  }
  .toggle button[aria-selected='true'] { background: var(--ink); color: var(--paper); }

  .body { margin: 0 0 32px; color: var(--ink-2); max-width: 62ch; }
  .summary {
    margin: 0 0 20px;
    font-family: var(--serif);
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.22;
    max-width: 30ch;
  }
  .facts { margin: 0; border-top: 1px solid var(--line); }
  .facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dt { font-size: 12px; color: var(--ink-3); padding-top: 3px; }
  .facts dd { margin: 0; }
  .raw {
    margin: 0;
    padding: 20px;
    font-size: 13px;
    line-height: 1.6;
    background: var(--paper-2);
    border: 1px solid var(--line);
    overflow-x: auto;
    color: var(--ink-2);
  }

  .schema { margin-top: clamp(56px, 8vw, 96px); border: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 90%, transparent); }
  .schema-head { display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: 12px; }
  .schema-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .group { padding: 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 -1px -1px 0; }
  .gname { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--signal); margin-bottom: 10px; }
  .group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .group li { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 14px; }
  .meter { display: inline-flex; gap: 3px; }
  .meter i { width: 7px; height: 7px; background: var(--queued); }
  .meter i.on { background: var(--ink); }
</style>

<script>
  import { renderDither } from '../scripts/dither';

  const frame = document.querySelector<HTMLElement>('#bronze .frame');
  frame?.addEventListener('click', () => frame.classList.toggle('open'));
  const canvas = document.getElementById('dither') as HTMLCanvasElement | null;
  const img = frame?.querySelector('img');
  if (canvas && img) {
    const draw = () => renderDither(canvas, img);
    if (img.complete) draw(); else img.addEventListener('load', draw, { once: true });
    addEventListener('themechange', draw);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', draw);
  }

  const tabs = document.querySelectorAll<HTMLButtonElement>('#bronze [role=tab]');
  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      document.querySelectorAll<HTMLElement>('#bronze [data-panel]').forEach((p) => {
        p.hidden = p.dataset.panel !== t.dataset.view;
      });
    }),
  );
</script>
