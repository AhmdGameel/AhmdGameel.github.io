---
import { person } from '../lib/data';
---

<section id="about" class="section about" aria-labelledby="about-h">
  <div class="section-head"><h2 id="about-h">About</h2></div>
  <div class="text">
    {person.about.map((t: string) => <p>{t}</p>)}
    <p class="community"><span class="sq" aria-hidden="true"></span>{person.community}</p>
  </div>
</section>

<style>
  .text { display: grid; gap: 14px; max-width: 64ch; color: var(--ink-2); font-size: 16.5px; }
  .community { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 14.5px; font-weight: 550; }
  .sq { width: 8px; height: 8px; border-radius: 2px; background: var(--accent); }
</style>
