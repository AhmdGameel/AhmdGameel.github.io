---
import { person } from '../lib/data';

const stages = [
  { id: 'source', layer: 'source', name: 'Intro' },
  { id: 'bronze', layer: 'bronze', name: 'About' },
  { id: 'silver', layer: 'silver', name: 'Experience' },
  { id: 'gold', layer: 'gold', name: 'Projects' },
  { id: 'serving', layer: 'serving', name: 'Ask my data' },
  { id: 'sink', layer: 'sink', name: 'Contact' },
];
---

<header class="topbar">
  <div class="topbar-inner">
    <a href="#source" class="brand" aria-label="Back to top">
      <img src="/favicon.svg" width="28" height="28" alt="" />
      <span class="brand-name">{person.name}</span>
    </a>
    <div class="readout mono" aria-hidden="true">
      <span class="faint">now reading</span>
      <span id="readout-stage">Intro</span>
    </div>
    <div class="actions">
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle color theme">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 1.5 A6.5 6.5 0 0 1 8 14.5 Z" fill="currentColor"/></svg>
      </button>
      <a class="btn small" href={person.cv} download>Resume <span aria-hidden="true">&#8595;</span></a>
    </div>
  </div>
</header>

<nav class="rail" aria-label="Sections">
  <ol>
    {stages.map((s, i) => (
      <li>
        <a href={`#${s.id}`} data-stage={s.id} data-name={s.name}>
          <span class="node" aria-hidden="true"></span>
          <span class="rail-text">
            <span class="name">{s.name}</span>
            <span class="mono layer">{s.layer}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  <span class="packet" aria-hidden="true"></span>
</nav>

<style>
  .topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 56px;
    padding: 0 var(--gutter);
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img { border-radius: 6px; }
  .brand-name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .readout { font-size: 12px; display: none; gap: 8px; }
  #readout-stage { color: var(--signal); }
  @media (min-width: 760px) { .readout { display: inline-flex; } }
  .actions { display: flex; align-items: center; gap: 10px; }
  .status { display: none; align-items: center; gap: 8px; font-size: 12px; color: var(--ink-2); margin-right: 6px; }
  @media (min-width: 560px) { .status { display: inline-flex; } }
  .icon-btn {
    width: 36px; height: 36px;
    display: grid; place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
  }
  .icon-btn:hover { border-color: var(--signal); color: var(--signal); }
  .btn.small { padding: 9px 12px; font-size: 12px; }

  .rail {
    display: none;
    position: fixed;
    z-index: 40;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
  }
  @media (min-width: 1100px) { .rail { display: block; } }
  .rail ol { list-style: none; margin: 0; padding: 0; position: relative; }
  .rail ol::before {
    content: '';
    position: absolute;
    left: 5px; top: 8px; bottom: 8px;
    width: 1px;
    background: var(--line-strong);
  }
  .rail li + li { margin-top: 26px; }
  .rail a { display: flex; align-items: flex-start; gap: 14px; text-decoration: none; }
  .node {
    position: relative;
    width: 11px; height: 11px;
    margin-top: 3px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    transition: background-color 0.3s, border-color 0.3s, transform 0.3s;
    flex: none;
  }
  .rail-text { display: flex; flex-direction: column; line-height: 1.25; }
  .layer { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .name { font-size: 13px; color: var(--ink-2); transition: color 0.3s; }
  .rail a:hover .name { color: var(--ink); }
  .rail a.done .node { background: var(--ink); border-color: var(--ink); }
  .rail a.active .node { background: var(--signal); border-color: var(--signal); transform: rotate(45deg); }
  .rail a.active .name { color: var(--ink); }
  .rail a.active .layer { color: var(--signal); }
  .packet {
    position: absolute;
    left: 3px; top: 0;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--signal);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    window.dispatchEvent(new CustomEvent('themechange'));
  });

  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail a')];
  const readout = document.getElementById('readout-stage');
  const packet = document.querySelector<HTMLElement>('.rail .packet');
  let current = '';

  function setActive(id: string) {
    if (id === current) return;
    const prevIdx = links.findIndex((l) => l.dataset.stage === current);
    current = id;
    const idx = links.findIndex((l) => l.dataset.stage === id);
    links.forEach((l, i) => {
      l.classList.toggle('active', i === idx);
      l.classList.toggle('done', i < idx);
    });
    if (readout) readout.textContent = links[idx]?.dataset.name ?? '';
    // A packet travels down (or up) the lineage line to the new stage.
    if (packet && prevIdx >= 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const from = links[prevIdx].querySelector('.node')!.getBoundingClientRect();
      const to = links[idx].querySelector('.node')!.getBoundingClientRect();
      const base = packet.parentElement!.getBoundingClientRect();
      packet.animate(
        [
          { top: `${from.top - base.top + 3}px`, opacity: 1 },
          { top: `${to.top - base.top + 3}px`, opacity: 1 },
          { top: `${to.top - base.top + 3}px`, opacity: 0 },
        ],
        { duration: 700, easing: 'cubic-bezier(.5,0,.2,1)' },
      );
    }
  }

  const sections = links
    .map((l) => document.getElementById(l.dataset.stage!))
    .filter((s): s is HTMLElement => !!s);

  function onScroll() {
    const mid = window.innerHeight * 0.4;
    let active = sections[0]?.id ?? '';
    for (const s of sections) if (s.getBoundingClientRect().top <= mid) active = s.id;
    setActive(active);
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
    { rootMargin: '0px 0px -10% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
