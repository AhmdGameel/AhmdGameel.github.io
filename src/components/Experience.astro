---
import { experience, fmtMonth, duration } from '../lib/data';

const work = experience.filter((e) => e.type === 'work');
const training = experience.filter((e) => e.type === 'training');
const when = (e: (typeof experience)[number]) => `${fmtMonth(e.start_month)} to ${e.is_current ? 'Present' : fmtMonth(e.end_month)}`;
---

<section id="experience" class="section" aria-labelledby="exp-h">
  <div class="section-head"><h2 id="exp-h">Experience</h2></div>

  <ol class="rows">
    {work.map((e) => (
      <li class="row reveal">
        <p class="when mono">{when(e)}</p>
        <div class="body">
          <h3>{e.role} <span class="at">at</span> {e.company}</h3>
          <p class="meta">{e.mode}, {duration(e.start_month, e.end_month)}{e.is_current && <span class="now">Current role</span>}</p>
          <ul class="hl">{e.highlights.map((h) => <li>{h}</li>)}</ul>
          <div class="stack">{e.stack.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      </li>
    ))}
  </ol>

  <h3 class="label sub">Training programs</h3>
  <ol class="rows">
    {training.map((e) => (
      <li class="row reveal">
        <p class="when mono">{when(e)}</p>
        <div class="body">
          <h3>{e.role} <span class="at">at</span> {e.company}</h3>
          <p class="meta">{e.mode}, {duration(e.start_month, e.end_month)}. {e.context}</p>
          <ul class="hl">{e.highlights.map((h) => <li>{h}</li>)}</ul>
          <div class="stack">{e.stack.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .row {
    display: grid; gap: 4px 24px;
    padding: 18px 20px; margin: 0 -20px;
    border-radius: var(--radius);
    transition: background-color 0.2s, box-shadow 0.2s;
  }
  .row:hover { background: var(--card); box-shadow: var(--shadow); }
  @media (min-width: 640px) { .row { grid-template-columns: 150px minmax(0, 1fr); } }
  .when { font-size: 12px; color: var(--ink-3); padding-top: 4px; }
  h3 { font-size: 16.5px; font-weight: 650; }
  .at { font-weight: 400; color: var(--ink-3); }
  .meta { margin-top: 2px; font-size: 14px; color: var(--ink-3); }
  .now { margin-left: 10px; font-size: 12px; font-weight: 550; color: var(--ok); background: var(--ok-soft); padding: 2px 8px; border-radius: 999px; }
  .hl { margin: 10px 0 12px; padding: 0 0 0 18px; display: grid; gap: 4px; color: var(--ink-2); font-size: 15px; }
  .hl li::marker { color: var(--ink-3); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .sub { margin: 36px 0 8px; font-size: 11.5px; font-weight: 400; letter-spacing: 0.06em; }
</style>
