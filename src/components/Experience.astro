---
import SectionHead from './SectionHead.astro';
import { experience, fmtMonth, monthRange, currentMonth } from '../lib/data';

const duration = (start: string, end: string | null) => {
  const n = monthRange(start, end ?? currentMonth()).length;
  return n === 1 ? '1 month' : `${n} months`;
};
---

<section id="experience" class="stage">
  <div class="wrap grid">
    <SectionHead index="02" title="Experience" />
    <ol class="roles">
      {experience.map((r) => (
        <li class="role reveal">
          <div class="when mono">
            <span>{fmtMonth(r.start_month)} to {r.is_current ? 'Present' : fmtMonth(r.end_month)}</span>
            <span class="faint">{duration(r.start_month, r.end_month)}, {r.mode}</span>
            {r.is_current && <span class="now">Current</span>}
          </div>
          <div class="what">
            <h3>{r.role}</h3>
            <p class="org">{r.company}</p>
            <ul class="hl">{r.highlights.map((h) => <li>{h}</li>)}</ul>
            <div class="stack">{r.stack.map((s) => <span class="chip">{s}</span>)}</div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .grid { display: grid; gap: 8px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 280px minmax(0, 1fr); gap: 48px; } }
  .roles { list-style: none; margin: 0; padding: 0; }
  .role {
    display: grid;
    gap: 8px 32px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .role:first-child { border-top: 0; padding-top: 4px; }
  @media (min-width: 700px) { .role { grid-template-columns: 170px minmax(0, 1fr); } }
  .when { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; font-size: 12.5px; color: var(--ink-2); padding-top: 4px; }
  .now { margin-top: 6px; font-size: 11px; color: var(--signal); background: var(--signal-soft); padding: 3px 8px; border-radius: 2px; }
  .what h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(24px, 2.3vw, 30px); line-height: 1.15; }
  .org { margin: 2px 0 0; font-weight: 600; font-size: 15px; }
  .hl { margin: 14px 0 16px; padding: 0; list-style: none; display: grid; gap: 7px; }
  .hl li { position: relative; padding-left: 20px; color: var(--ink-2); font-size: 15.5px; }
  .hl li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 9px; height: 1px; background: var(--signal); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
