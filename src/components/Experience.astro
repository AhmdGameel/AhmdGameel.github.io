---
import SectionHead from './SectionHead.astro';
import { experience, education, monthRange, currentMonth, fmtMonth } from '../lib/data';

const now = currentMonth();
const edu = education[0];
type Row = {
  id: string; task: string; role: string; org: string; mode: string;
  start: string; end: string | null; current: boolean; kind: 'work' | 'study';
  highlights: string[]; stack: string[];
};

const rows: Row[] = [
  ...experience.map((e) => ({
    id: e.id, task: e.id.replace(/-/g, '_'), role: e.role, org: e.company, mode: e.mode,
    start: e.start_month, end: e.end_month, current: e.is_current, kind: 'work' as const,
    highlights: e.highlights, stack: e.stack,
  })),
  {
    id: 'education', task: 'bsc_ai', role: edu.degree, org: edu.school, mode: `GPA ${edu.gpa}`,
    start: `${edu.start}-09`, end: `${edu.end}-06`, current: false, kind: 'study',
    highlights: [`Relevant coursework: ${edu.coursework.join(', ')}.`],
    stack: ['Distributed Systems', 'Databases', 'Big Data', 'Machine Learning'],
  },
];

const first = rows.reduce((a, r) => (r.start < a ? r.start : a), now);
const months = monthRange(first, now);
const stateOf = (r: Row, m: string) => {
  const end = r.end ?? now;
  if (m < r.start || m > end) return 'none';
  if (r.current && m === now) return 'running';
  return 'success';
};
const runs = rows.reduce((n, r) => n + months.filter((m) => stateOf(r, m) !== 'none').length, 0);
const running = rows.filter((r) => r.current).length;
const fmtRange = (r: Row) => `${fmtMonth(r.start)} to ${fmtMonth(r.current ? null : r.end)}`;
---

<section id="silver" class="stage">
  <div class="wrap">
    <SectionHead
      index="02"
      label="Experience"
      table="silver.career_runs"
      intro="Read it like an Airflow grid: one row per role, one square per month. Green means done, the outlined square is the month I am in right now."
    >
      Every month is a run. <em>None of them failed.</em>
    </SectionHead>

    <div class="dag reveal">
      <div class="dag-meta mono">
        <span><span class="faint">dag_id</span> career</span>
        <span><span class="faint">task runs</span> {runs}</span>
        <span><span class="sw ok"></span>success {runs - running}</span>
        <span><span class="sw run"></span>running {running}</span>
        <span><span class="sw fail"></span>failed 0</span>
      </div>

      <div class="gridview" style={`--cols:${months.length}`}>
        <div class="row header" aria-hidden="true">
          <div class="task"></div>
          <div class="cells">
            {months.map((m) => (
              <span class={m.endsWith('-01') ? 'yr' : ''}>{m.endsWith('-01') ? m.slice(0, 4) : ''}</span>
            ))}
          </div>
        </div>

        {rows.map((r, i) => (
          <a class="row" href={`#role-${r.id}`} data-id={r.id}>
            <div class="task">
              <span class="mono tid">{r.task}</span>
              <span class="tname">{r.org}</span>
            </div>
            <div class="cells" aria-label={`${r.role} at ${r.org}, ${fmtRange(r)}`}>
              {months.map((m) => <i class={`c ${stateOf(r, m)} ${r.kind}`} title={`${r.task} ${m} ${stateOf(r, m)}`}></i>)}
            </div>
          </a>
        ))}
      </div>

    </div>

    <ol class="roles">
      {rows.map((r) => (
        <li class="role-item reveal" id={`role-${r.id}`}>
          <div class="when mono">
            <span>{fmtRange(r)}</span>
            <span class={`state ${r.current ? 'run' : 'ok'}`}>{r.current ? 'in progress' : r.kind === 'study' ? 'graduated' : 'completed'}</span>
          </div>
          <div class="what">
            <h3><span class="serif">{r.role}</span> <span class="org">{r.org}</span></h3>
            <p class="mode mono faint">{r.mode}</p>
            <ul class="hl">{r.highlights.map((h) => <li>{h}</li>)}</ul>
            <div class="stack">{r.stack.map((s) => <span class="chip">{s}</span>)}</div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .dag { border: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 92%, transparent); }
  .dag-meta {
    display: flex; flex-wrap: wrap; gap: 8px 24px;
    padding: 12px 16px;
    font-size: 12px;
    border-bottom: 1px solid var(--line);
  }
  .dag-meta > span { display: inline-flex; align-items: center; gap: 7px; }
  .sw { width: 9px; height: 9px; display: inline-block; }
  .sw.ok { background: var(--ok); }
  .sw.run { background: transparent; border: 2px solid var(--signal); }
  .sw.fail { background: transparent; border: 1px solid var(--line-strong); }

  .gridview { padding: 8px 0; }
  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    width: 100%;
    padding: 10px 16px;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    border-left: 2px solid transparent;
  }
  @media (min-width: 760px) {
    .row { grid-template-columns: 210px 1fr; align-items: center; gap: 16px; }
  }
  .row:not(.header):hover { background: var(--paper-2); }
  .row:hover { border-left-color: var(--signal); }
  .row.header { cursor: default; padding-top: 4px; padding-bottom: 0; }
  @media (max-width: 759px) { .row.header .task { display: none; } }
  .task { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .tid { font-size: 12px; color: var(--ink); }
  .tname { font-size: 12px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .cells { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 2px; }
  .header .cells span { font-family: var(--mono); font-size: 10px; color: var(--ink-3); white-space: nowrap; height: 14px; }
  .c { display: block; aspect-ratio: 1; max-height: 16px; border-radius: 1px; background: var(--paper-3); }
  .c.none { background: color-mix(in srgb, var(--line) 55%, transparent); }
  .c.success { background: var(--ok); }
  .c.success.study { background: color-mix(in srgb, var(--ok) 45%, var(--paper-3)); }
  .c.running { background: transparent; box-shadow: inset 0 0 0 2px var(--signal); animation: blink 1.4s ease-in-out infinite; }
  @keyframes blink { 50% { box-shadow: inset 0 0 0 2px var(--signal), 0 0 0 3px var(--signal-soft); } }

  .row { color: inherit; text-decoration: none; }
  .roles { list-style: none; margin: clamp(40px, 6vw, 64px) 0 0; padding: 0; }
  .role-item {
    display: grid;
    gap: 10px 32px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 90px;
  }
  .role-item:target .what h3 .serif { color: var(--signal); }
  @media (min-width: 860px) { .role-item { grid-template-columns: 220px 1fr; } }
  .when { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; font-size: 12px; color: var(--ink-2); padding-top: 6px; }
  .what h3 { margin: 0; font-weight: 400; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .what h3 .serif { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.1; transition: color 0.3s; }
  .org { font-size: 15px; font-weight: 600; }
  .mode { margin: 4px 0 0; font-size: 12px; }
  .state { font-size: 11px; padding: 3px 8px; border-radius: 2px; white-space: nowrap; }
  .state.ok { color: var(--ok); background: var(--ok-soft); }
  .state.run { color: var(--signal); background: var(--signal-soft); }
  .hl { margin: 16px 0; padding: 0; list-style: none; display: grid; gap: 8px; max-width: 760px; }
  .hl li { position: relative; padding-left: 22px; color: var(--ink-2); }
  .hl li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 10px; height: 1px; background: var(--signal); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
