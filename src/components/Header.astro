---
import { person } from '../lib/data';
import Icon from './Icon.astro';
import Mark from './Mark.astro';

interface Props { home?: boolean }
const { home = true } = Astro.props;
const base = home ? '' : '/';
const links = [
  { id: 'work', label: 'Work' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'platform', label: 'Platform' },
  { id: 'contact', label: 'Contact' },
];
---

<a class="skip" href="#main">Skip to content</a>

<header class="topbar night" id="topbar" data-over="hero">
  <div class="inner">
    <a href={home ? '#top' : '/'} class="brand" aria-label={`${person.name}, home`}>
      <Mark size={30} />
      <span class="who"><span class="nm">{person.name}</span><span class="mono rl">data engineer</span></span>
    </a>

    <nav class="nav" aria-label="Sections">
      {links.map((l) => <a href={`${base}#${l.id}`} data-link={l.id}>{l.label}</a>)}
    </nav>

    <div class="actions">
      <div class="lens" role="group" aria-label="Choose how much detail to show">
        <button type="button" data-lens-btn="recruiter" aria-pressed="true" title="Plain language, the essentials">Recruiter</button>
        <button type="button" data-lens-btn="engineer" aria-pressed="false" title="Trade-offs, lineage, internals and SQL">Engineer</button>
        <span class="knob" aria-hidden="true"></span>
      </div>
      <button class="icon-btn kbd-btn" type="button" data-palette-open aria-label="Open command palette" title="Command palette (Ctrl K)">
        <span class="mono">Ctrl K</span>
      </button>
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Switch between night and day theme" title="Night or day">
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor" /></svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
      <a class="btn small resume" href={person.cv} download>
        <Icon name="download" size={14} /> <span>Resume</span>
      </a>
      <button id="menu-toggle" class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Sections" hidden>
    {links.map((l) => <a href={`${base}#${l.id}`}>{l.label}</a>)}
    <div class="lens lens-m" role="group" aria-label="Choose how much detail to show">
      <button type="button" data-lens-btn="recruiter" aria-pressed="true">Recruiter view</button>
      <button type="button" data-lens-btn="engineer" aria-pressed="false">Engineer view</button>
      <span class="knob" aria-hidden="true"></span>
    </div>
  </nav>
</header>

<style>
  .skip {
    position: fixed; left: 12px; top: -60px; z-index: 200;
    background: var(--amber); color: var(--on-amber);
    padding: 10px 14px; border-radius: 999px; text-decoration: none; font-family: var(--mono); font-size: 12px;
  }
  .skip:focus { top: 12px; }
  @media print { .skip { display: none; } }

  .topbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    transition: background-color 0.3s, border-color 0.3s;
  }
  .topbar[data-over='hero'] { background: color-mix(in srgb, var(--bg) 35%, transparent); border-bottom-color: transparent; }
  .inner {
    max-width: var(--max);
    margin: 0 auto;
    height: var(--head);
    padding: 0 var(--gutter);
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; white-space: nowrap; }
  .who { display: flex; flex-direction: column; line-height: 1.15; }
  .nm { font-weight: 650; font-size: 14.5px; letter-spacing: -0.01em; }
  .rl { font-size: 10px; color: var(--ink-3); }
  @media (max-width: 420px) { .rl { display: none; } }

  .nav { display: none; gap: 2px; }
  .nav a {
    position: relative; padding: 8px 12px;
    font-size: 13.5px; color: var(--ink-2); text-decoration: none;
    border-radius: 999px; transition: color 0.2s, background-color 0.2s;
  }
  .nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 7%, transparent); }
  .nav a.active { color: var(--ink); }
  .nav a.active::after { content: ''; position: absolute; left: 50%; bottom: 1px; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 10px var(--amber); }

  .actions { display: flex; align-items: center; gap: 8px; }
  .icon-btn {
    height: 36px; min-width: 36px; padding: 0 10px;
    display: inline-grid; place-items: center;
    border: 1px solid var(--line-2); border-radius: 999px;
    background: transparent; cursor: pointer; color: var(--ink-2);
    transition: color 0.2s, border-color 0.2s;
  }
  .icon-btn:hover { color: var(--amber); border-color: var(--amber); }
  .kbd-btn .mono { font-size: 10.5px; }
  .kbd-btn { display: none; }
  .sun { display: none; }
  :global(:root[data-theme='day']) .sun { display: block; }
  :global(:root[data-theme='day']) .moon { display: none; }

  .lens {
    position: relative; display: none; grid-template-columns: 1fr 1fr;
    padding: 3px; border: 1px solid var(--line-2); border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
  }
  .lens button {
    position: relative; z-index: 1;
    border: 0; background: transparent; cursor: pointer;
    font-family: var(--mono); font-size: 11px; padding: 7px 12px; border-radius: 999px;
    color: var(--ink-2); transition: color 0.25s;
  }
  .lens button[aria-pressed='true'] { color: var(--on-amber); }
  .knob {
    position: absolute; z-index: 0; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px);
    border-radius: 999px; background: var(--amber);
    box-shadow: 0 0 18px var(--amber-glow);
    transition: transform 0.35s var(--ease);
  }
  :global(:root[data-lens='engineer']) .knob { transform: translateX(100%); }

  .resume span { display: none; }
  @media (min-width: 560px) { .resume span { display: inline; } }

  .mobile-nav { display: grid; padding: 8px var(--gutter) 20px; border-top: 1px solid var(--line); background: var(--bg); }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav > a { padding: 14px 0; text-decoration: none; font-size: 18px; border-bottom: 1px solid var(--line); }
  .lens-m { display: grid; margin-top: 16px; }
  .lens-m button { padding: 11px 12px; font-size: 12px; }

  @media (min-width: 1040px) {
    .nav { display: flex; }
    .lens { display: grid; }
    .kbd-btn { display: inline-grid; }
    .menu-btn, .mobile-nav { display: none !important; }
  }
  @media (min-width: 720px) and (max-width: 1039px) {
    .lens:not(.lens-m) { display: grid; }
  }
</style>

<script>
  const root = document.documentElement;
  const bar = document.getElementById('topbar')!;

  // Lens: recruiter or engineer
  const setLens = (lens: string, persist = true) => {
    if (lens === 'engineer') root.dataset.lens = 'engineer';
    else delete root.dataset.lens;
    document.querySelectorAll<HTMLButtonElement>('[data-lens-btn]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.lensBtn === (lens === 'engineer' ? 'engineer' : 'recruiter'))),
    );
    if (persist) {
      try { localStorage.setItem('lens', lens); } catch {}
      const u = new URL(location.href);
      if (lens === 'engineer') u.searchParams.set('lens', 'engineer'); else u.searchParams.delete('lens');
      history.replaceState(null, '', u);
    }
    window.dispatchEvent(new CustomEvent('lenschange', { detail: lens }));
  };
  setLens(root.dataset.lens === 'engineer' ? 'engineer' : 'recruiter', false);
  document.querySelectorAll<HTMLButtonElement>('[data-lens-btn]').forEach((b) => b.addEventListener('click', () => setLens(b.dataset.lensBtn!)));
  window.addEventListener('setlens', (e) => setLens((e as CustomEvent).detail));

  // Theme: night (default) or day
  const toggleTheme = () => {
    const day = root.dataset.theme !== 'day';
    if (day) root.dataset.theme = 'day'; else delete root.dataset.theme;
    try { localStorage.setItem('theme', day ? 'day' : 'night'); } catch {}
    window.dispatchEvent(new CustomEvent('themechange'));
  };
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  window.addEventListener('toggletheme', toggleTheme);

  // Mobile menu
  const menuBtn = document.getElementById('menu-toggle');
  const mobile = document.getElementById('mobile-nav');
  const setMenu = (open: boolean) => {
    if (!menuBtn || !mobile) return;
    mobile.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuBtn?.addEventListener('click', () => setMenu(mobile!.hidden));
  mobile?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Over the night hero the bar stays dark, after it follows the theme.
  const hero = document.getElementById('top');
  const setOver = (over: boolean) => {
    bar.dataset.over = over ? 'hero' : '';
    bar.classList.toggle('night', over);
  };
  const checkOver = () => setOver(!!hero && hero.getBoundingClientRect().bottom > 64);
  addEventListener('scroll', checkOver, { passive: true });
  checkOver();

  // Highlight the section being read
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav a[data-link]')];
  const sections = links.map((l) => document.getElementById(l.dataset.link!)).filter(Boolean) as HTMLElement[];
  const onScroll = () => {
    const mid = innerHeight * 0.35;
    let active = '';
    for (const s of sections) if (s.getBoundingClientRect().top <= mid) active = s.id;
    links.forEach((l) => l.classList.toggle('active', l.dataset.link === active));
  };
  if (sections.length) { addEventListener('scroll', onScroll, { passive: true }); onScroll(); }
</script>
