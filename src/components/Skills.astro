---
import { skillGroups, education, certifications, fmtMonth } from '../lib/data';

const edu = education[0];
---

<section id="skills" class="section" aria-labelledby="skills-h">
  <div class="section-head">
    <h2 id="skills-h">Skills</h2>
  </div>

  <dl class="groups">
    {skillGroups.map((g) => (
      <div class="group">
        <dt>{g.group}</dt>
        <dd>
          {g.items.map((s) => <span class="skill">{s}</span>)}
        </dd>
      </div>
    ))}
  </dl>

  <div class="edu">
    <div>
      <h3 class="label">Education</h3>
      <p class="big">{edu.degree}</p>
      <p class="muted">{edu.school}, {edu.start} to {edu.end}, GPA {edu.gpa}</p>
      <p class="faint small">Coursework: {edu.coursework.join(', ')}.</p>
    </div>
    <div>
      <h3 class="label">Certificates</h3>
      <ul class="certs">
        {certifications.map((c) => (
          <li>
            <span class="cname">{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}</a> : c.name}</span>
            <span class="faint">{c.issuer}, {fmtMonth(String(c.date).slice(0, 7))}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .groups { margin: 0; display: grid; }
  .group { display: grid; gap: 8px 20px; padding: 14px 0; border-top: 1px solid var(--line); }
  @media (min-width: 640px) { .group { grid-template-columns: 170px minmax(0, 1fr); align-items: baseline; } }
  .group dt { font-size: 14px; font-weight: 600; }
  .group dd { margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .skill {
    display: inline-flex; align-items: center;
    padding: 5px 11px; border-radius: 999px;
    background: var(--card); border: 1px solid var(--line);
    font-size: 13.5px;
  }

  .edu { display: grid; gap: 28px; margin-top: 40px; }
  @media (min-width: 720px) { .edu { grid-template-columns: 1fr 1fr; } }
  .edu h3 { margin-bottom: 10px; font-weight: 400; }
  .big { font-size: 17px; font-weight: 650; }
  .small { margin-top: 6px; font-size: 14px; }
  .certs { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .certs li { display: grid; gap: 1px; }
  .cname { font-weight: 600; font-size: 15px; }
  .certs .faint { font-size: 13.5px; }
</style>
