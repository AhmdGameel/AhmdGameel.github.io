---
import Icon from './Icon.astro';
import { person, whatsapp } from '../lib/data';
---

<section id="contact" class="section" aria-labelledby="contact-h">
  <div class="section-head">
    <h2 id="contact-h">Contact</h2>
    <p>Have a Data Engineering role in mind? Email me or message me on WhatsApp, or use the form below.</p>
  </div>

  <div class="mail">
    <a class="address" href={`mailto:${person.email}`}>{person.email}</a>
    <div class="row">
      <button class="btn ghost small" type="button" data-copy={person.email}><Icon name="copy" size={14} /> <span>Copy email</span></button>
      <a class="btn ghost small wa" href={whatsapp.url()} target="_blank" rel="noopener"><Icon name="whatsapp" size={14} /> WhatsApp {whatsapp.display}</a>
      <a class="btn ghost small" href={person.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={14} /> LinkedIn</a>
      <a class="btn ghost small" href={person.cv} download><Icon name="download" size={14} /> Resume</a>
    </div>
  </div>

  <form class="form" id="contact-form" data-endpoint={`https://formsubmit.co/ajax/${person.email}`} novalidate>
    <p class="label form-title">Or send a quick message</p>
    <div class="row2">
      <label class="field"><input name="name" type="text" autocomplete="name" required maxlength="120" placeholder=" " /><span>Your name</span></label>
      <label class="field"><input name="email" type="email" autocomplete="email" required maxlength="200" placeholder=" " /><span>Your email</span></label>
    </div>
    <label class="field"><textarea name="message" rows="3" required maxlength="5000" placeholder=" "></textarea><span>A role, a project, or a question</span></label>
    <input class="honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="send">
      <p class="status" id="form-status" role="status" aria-live="polite"></p>
      <button class="btn small" type="submit"><Icon name="send" size={14} /><span>Send</span></button>
    </div>
  </form>
</section>

<style>
  .mail { display: grid; gap: 12px; margin-bottom: 28px; }
  .address { font-size: clamp(20px, 2.4vw, 26px); font-weight: 650; letter-spacing: -0.02em; text-decoration: none; overflow-wrap: anywhere; justify-self: start; border-bottom: 2px solid var(--line-2); }
  .address:hover { border-color: currentColor; }
  .row { display: flex; flex-wrap: wrap; gap: 8px; }
  .wa :global(svg) { color: #1ea952; }
  .wa { font-variant-numeric: tabular-nums; }
  .form {
    display: grid; gap: 8px; max-width: 620px;
    padding: 16px 18px 14px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .form-title { margin-bottom: 2px; }
  .row2 { display: grid; gap: 8px; }
  @media (min-width: 640px) { .row2 { grid-template-columns: 1fr 1fr; } }

  /* Floating labels: the label sits inside the field and moves up once the field has focus or text. */
  .field { position: relative; display: block; }
  .field input, .field textarea {
    display: block; width: 100%;
    font: inherit; font-size: 15px; line-height: 1.5; color: var(--ink);
    padding: 18px 12px 4px;
    background: var(--bg); border: 1px solid var(--line); border-radius: 9px;
    outline: none; transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }
  .field textarea { resize: vertical; min-height: 80px; padding-top: 22px; }
  .field span {
    position: absolute; left: 13px; top: 11px;
    font-size: 15px; color: var(--ink-3); pointer-events: none;
    transform-origin: left top; transition: transform 0.15s var(--ease), color 0.15s;
  }
  .field input:focus + span, .field input:not(:placeholder-shown) + span,
  .field textarea:focus + span, .field textarea:not(:placeholder-shown) + span { transform: translateY(-7px) scale(0.76); }
  .field input:focus + span, .field textarea:focus + span { color: var(--accent); }
  .field input:hover, .field textarea:hover { border-color: var(--line-2); }
  .field input:focus, .field textarea:focus { border-color: var(--accent); background: var(--card); box-shadow: 0 0 0 3px var(--accent-soft); }
  .field [aria-invalid='true'] { border-color: #c2410c; }
  /* Phones zoom into fields under 16px. */
  @media (max-width: 640px) { .field input, .field textarea, .field span { font-size: 16px; } }
  .honey { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .send { display: flex; align-items: center; justify-content: flex-end; gap: 12px 16px; margin-top: 2px; }
  .send .btn { flex: none; padding-inline: 14px; }
  .send .btn[disabled] { opacity: 0.6; cursor: wait; }
  .status { margin: 0 auto 0 0; font-size: 13.5px; color: var(--ink-2); }
  .status.ok { color: var(--ok); }
  .status.err { color: #c2410c; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const setStatus = (text: string, kind = '') => {
    if (!statusEl) return;
    statusEl.textContent = text;
    statusEl.className = `status ${kind}`;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')];
    let firstBad: HTMLElement | null = null;
    for (const f of fields) {
      const bad = !f.value.trim() || (f.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.value.trim()));
      f.setAttribute('aria-invalid', String(bad));
      if (bad && !firstBad) firstBad = f;
    }
    if (firstBad) {
      setStatus('Please fill in every field with a valid email.', 'err');
      firstBad.focus();
      return;
    }
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (data._honey) return; // bots fill hidden fields
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.querySelector('span')!;
    button.disabled = true;
    label.textContent = 'Sending...';
    setStatus('');
    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          name: data.name.trim(),
          email: data.email.trim(),
          _replyto: data.email.trim(),
          _subject: `Portfolio message from ${data.name.trim()}`,
          message: data.message.trim(),
          _template: 'table',
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || String(json.success) !== 'true') throw new Error(json.message || `HTTP ${res.status}`);
      form.reset();
      fields.forEach((f) => f.removeAttribute('aria-invalid'));
      setStatus('Thanks, your message was sent. I will reply to your email soon.', 'ok');
    } catch {
      setStatus('Sorry, the message could not be sent. Please email me directly.', 'err');
    } finally {
      button.disabled = false;
      label.textContent = 'Send';
    }
  });
  form?.querySelectorAll('input, textarea').forEach((f) => f.addEventListener('input', () => f.removeAttribute('aria-invalid')));

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const span = b.querySelector('span') ?? b;
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); span.textContent = 'Copied'; } catch { span.textContent = 'Press Ctrl C'; }
      setTimeout(() => (span.textContent = 'Copy email'), 1800);
    }),
  );

</script>
