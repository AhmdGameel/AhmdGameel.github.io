---
import Icon from './Icon.astro';
import { evidence, person, whatsapp } from '../lib/data';
import { REQS, type EvidenceMap } from '../lib/fit';

const short = (s: string) => s.replace('Digital Egypt Pioneers Initiative', 'DEPI').replace('Orange Digital Center Egypt', 'Orange Digital Center').replace(' track)', ')');
const map: EvidenceMap = {};
for (const e of evidence) (map[e.skill] ??= []).push({ label: short(e.evidence), kind: e.kind as EvidenceMap[string][number]['kind'] });
const popular = REQS.filter((r) => r.popular).map((r) => r.label);
const site = 'https://ahmdgameel.github.io';
---

<section id="fit" class="section" aria-labelledby="fit-h">
  <div class="section-head">
    <h2 id="fit-h">Hiring? Check the fit in 10 seconds</h2>
    <p>
      Paste the job description or pick what the role needs. You will see where I have used each skill, and what I
      have not used yet. It runs in your browser and nothing is sent anywhere.
    </p>
  </div>

  <div class="fit" data-evidence={JSON.stringify(map)} data-name={person.name} data-email={person.email} data-site={site} data-cv={`${site}${person.cv}`} data-wa={whatsapp.url('')}>
    <label class="label" for="jd">Job description</label>
    <textarea id="jd" rows="5" placeholder="Paste the job post here. For example: We are looking for a data engineer with Python, SQL, Spark and Airflow on AWS..."></textarea>

    <p class="label picks-label">Or pick requirements</p>
    <div class="picks" role="group" aria-label="Requirements">
      {popular.map((p) => <button type="button" class="pick" aria-pressed="false" data-req={p}>{p}</button>)}
    </div>

    <div class="out" aria-live="polite">
      <p class="empty">Results show up here as you type or pick.</p>
      <div class="result" hidden>
        <p class="score"><b data-score></b> <span data-score-text></span></p>
        <ul class="list" data-list></ul>
        <div class="actions">
          <a class="btn" data-mail href={`mailto:${person.email}`}><Icon name="mail" size={16} /> Email me about this role</a>
          <a class="btn ghost wa" data-wa href={whatsapp.url()} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> WhatsApp</a>
          <button class="btn ghost" type="button" data-copy-summary><Icon name="copy" size={15} /> <span>Copy summary</span></button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fit { padding: 22px 24px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: 10px; }
  textarea {
    width: 100%; resize: vertical; min-height: 110px;
    font: inherit; font-size: 15px; color: var(--ink);
    padding: 12px 14px; border-radius: 10px;
    background: var(--bg); border: 1px solid var(--line-2); outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea::placeholder { color: var(--ink-3); }
  textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .picks-label { margin-top: 6px; }
  .picks { display: flex; flex-wrap: wrap; gap: 6px; }
  .pick {
    padding: 6px 12px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line-2); background: transparent; font-size: 13.5px; color: var(--ink-2);
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .pick:hover { border-color: var(--ink-3); color: var(--ink); }
  .pick[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

  .out { margin-top: 10px; padding-top: 16px; border-top: 1px solid var(--line); }
  .empty { color: var(--ink-3); font-size: 14px; }
  .score { font-size: 15px; color: var(--ink-2); }
  .score b { font-size: 22px; color: var(--ink); margin-right: 4px; }
  .list { list-style: none; margin: 14px 0 18px; padding: 0; display: grid; gap: 8px; }
  .list :global(li) { display: grid; grid-template-columns: 22px 1fr; gap: 2px 10px; align-items: start; }
  .list :global(.ic) { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; margin-top: 1px; font-size: 12px; font-weight: 700; }
  .list :global(.yes .ic) { background: var(--ok-soft); color: var(--ok); }
  .list :global(.no .ic) { background: var(--bg-2); color: var(--ink-3); }
  .list :global(.name) { font-weight: 600; font-size: 15px; }
  .list :global(.ev) { grid-column: 2; font-size: 13.5px; color: var(--ink-3); }
  .list :global(.ev b) { font-weight: 550; color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .wa :global(svg) { color: #1ea952; }
</style>

<script>
  import { evaluate, type EvidenceMap, type Match } from '../lib/fit';

  const root = document.querySelector<HTMLElement>('#fit .fit');
  if (root) {
    const evidence: EvidenceMap = JSON.parse(root.dataset.evidence || '{}');
    const { name = '', email = '', site = '', cv = '', wa: waBase = '' } = root.dataset;
    const jd = root.querySelector<HTMLTextAreaElement>('#jd')!;
    const picks = [...root.querySelectorAll<HTMLButtonElement>('.pick')];
    const empty = root.querySelector<HTMLElement>('.empty')!;
    const result = root.querySelector<HTMLElement>('.result')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const score = root.querySelector<HTMLElement>('[data-score]')!;
    const scoreText = root.querySelector<HTMLElement>('[data-score-text]')!;
    const mail = root.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const wa = root.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-copy-summary]')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    let summary = '';

    const list3 = (xs: string[]) => xs.slice(0, 3).join(', ') + (xs.length > 3 ? ` and ${xs.length - 3} more` : '');
    const describe = (m: Match) => {
      if (!m.best) return 'Not used yet';
      const of = (kinds: string[]) => m.proofs.filter((p) => kinds.includes(p.kind)).map((p) => p.label);
      const work = of(['work']), built = of(['project', 'repo']), learned = of(['training', 'cert']);
      const parts = [];
      if (work.length) parts.push(`Used at work at ${list3(work)}.`);
      if (built.length) parts.push(`${work.length ? 'Also in' : 'Built in'} ${list3(built)}.`);
      if (learned.length && !work.length && !built.length) parts.push(`Learned in ${list3(learned)}.`);
      return parts.join(' ');
    };

    const render = () => {
      const picked = new Set(picks.filter((p) => p.getAttribute('aria-pressed') === 'true').map((p) => p.dataset.req!));
      const matches = evaluate(jd.value, picked, evidence);
      if (!matches.length) {
        empty.hidden = false;
        empty.textContent = jd.value.trim() ? 'No familiar requirements found yet. Try picking a few below the text box.' : 'Results show up here as you type or pick.';
        result.hidden = true;
        return;
      }
      const hits = matches.filter((m) => m.best);
      const gaps = matches.filter((m) => !m.best);
      empty.hidden = true;
      result.hidden = false;
      score.textContent = `${hits.length} of ${matches.length}`;
      scoreText.textContent = 'requirements I have hands on proof for';
      list.innerHTML = matches
        .map((m) => `<li class="${m.best ? 'yes' : 'no'}"><span class="ic" aria-hidden="true">${m.best ? '&#10003;' : '&#9675;'}</span><span class="name">${esc(m.req.label)}</span><span class="ev">${esc(describe(m))}</span></li>`)
        .join('');

      const lines = hits.map((m) => `- ${m.req.label}: ${describe(m)}`);
      summary = [
        `${name}, Data Engineer, Cairo, Egypt`,
        `Matches ${hits.length} of ${matches.length} requirements:`,
        ...lines,
        gaps.length ? `Not used yet: ${gaps.map((g) => g.req.label).join(', ')}` : '',
        `Portfolio: ${site}/`,
        `Resume: ${cv}`,
      ].filter(Boolean).join('\n');

      const needs = matches.map((m) => m.req.label).join(', ');
      const body = `Hi ${name.split(' ')[0]},\n\nI am hiring for a role that needs: ${needs}.\n\nRole:\nCompany:\nLink to the job post:\n\nBest regards,\n`;
      mail.href = `mailto:${email}?subject=${encodeURIComponent('About a data engineering role')}&body=${encodeURIComponent(body)}`;
      wa.href = waBase + encodeURIComponent(`Hi ${name.split(' ')[0]}, I found your portfolio. I am hiring for a Data Engineering role that needs: ${needs}. Can we talk?`);
    };

    let t = 0;
    jd.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(render, 150); });
    picks.forEach((p) => p.addEventListener('click', () => {
      p.setAttribute('aria-pressed', String(p.getAttribute('aria-pressed') !== 'true'));
      render();
    }));
    copy.addEventListener('click', async () => {
      const label = copy.querySelector('span')!;
      try { await navigator.clipboard.writeText(summary); label.textContent = 'Copied'; } catch { label.textContent = 'Copy failed'; }
      setTimeout(() => (label.textContent = 'Copy summary'), 1800);
    });
  }
</script>
