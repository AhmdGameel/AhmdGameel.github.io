---
import Icon from './Icon.astro';
import { person } from '../lib/data';
---

<a class="skip" href="#content">Skip to content</a>
<header class="bar">
  <div class="inner">
    <a class="home" href="/"><Icon name="back" size={15} /> <span>{person.name}</span><small>{person.title}</small></a>
    <div class="actions">
      <button class="theme" type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Light or dark">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M8 1.5 A6.5 6.5 0 0 1 8 14.5 Z" fill="currentColor" /></svg>
      </button>
      <a class="btn small ghost" href={person.cv} download>Resume</a>
      <a class="btn small" href={`mailto:${person.email}`}>Email me</a>
    </div>
  </div>
</header>

<style>
  .skip { position: fixed; left: 12px; top: -60px; z-index: 200; background: var(--accent); color: var(--on-accent); padding: 10px 14px; border-radius: 8px; text-decoration: none; font-size: 14px; }
  .skip:focus { top: 12px; }
  .bar {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .inner { max-width: var(--max); margin: 0 auto; padding: 10px var(--gutter); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .home { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 650; font-size: 15px; }
  .home small { font-weight: 400; color: var(--ink-3); font-size: 13px; }
  @media (max-width: 520px) { .home small { display: none; } }
  .actions { display: flex; align-items: center; gap: 8px; }
  .theme { width: 36px; height: 36px; display: grid; place-items: center; border: 0; background: transparent; border-radius: 8px; color: var(--ink-3); cursor: pointer; }
  .theme:hover { background: var(--bg-2); color: var(--ink); }
  @media print { .bar, .skip { display: none; } }
</style>
