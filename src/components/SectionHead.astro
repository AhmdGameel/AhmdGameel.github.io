---
interface Props { index: string; kicker: string; title: string; intro?: string }
const { index, kicker, title, intro } = Astro.props;
---

<header class="head reveal">
  <p class="kicker"><span class="mono">{index}</span> {kicker}</p>
  <h2 class="h2" set:html={title} />
  {intro && <p class="lede">{intro}</p>}
  <slot />
</header>

<style>
  .head { display: grid; gap: 18px; margin-bottom: clamp(40px, 6vw, 72px); max-width: 980px; }
  .head :global(em) { font-style: normal; color: var(--amber); }
</style>
