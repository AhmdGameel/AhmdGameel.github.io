---
interface Props { index: string; label: string; table: string; intro?: string }
const { index, label, table, intro } = Astro.props;
---

<header class="head">
  <div class="bar reveal">
    <span class="idx mono">{index}</span>
    <span class="label-plain">{label}</span>
    <span class="rule" aria-hidden="true"></span>
    <span class="table mono" title="Pipeline stage">{table}</span>
  </div>
  <h2 class="title serif reveal"><slot /></h2>
  {intro && <p class="intro reveal">{intro}</p>}
</header>

<style>
  .head { margin-bottom: clamp(40px, 6vw, 64px); }
  .bar { display: flex; align-items: center; gap: 12px; }
  .idx { font-size: 12px; color: var(--signal); }
  .label-plain { font-size: 13px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; }
  .rule { flex: 1; height: 1px; background: var(--line); min-width: 24px; }
  .table { font-size: 11.5px; color: var(--ink-3); white-space: nowrap; }
  @media (max-width: 420px) { .table { display: none; } }
  .title {
    margin: 22px 0 0;
    font-size: clamp(40px, 6vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 16ch;
    transition-delay: 0.08s;
  }
  .title :global(em) { color: var(--ink-3); }
  .intro {
    margin: 18px 0 0;
    max-width: 58ch;
    font-size: clamp(16px, 1.4vw, 18px);
    color: var(--ink-2);
    transition-delay: 0.16s;
  }
</style>
