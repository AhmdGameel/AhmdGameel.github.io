---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Platform from '../components/Platform.astro';
import Footer from '../components/Footer.astro';
import { pipelineRun as run } from '../lib/data';

const blocking = run.checks.filter((c) => c.blocking).length;
---

<Base title="How this site is built | Ahmed Gameel" description="The portfolio is the output of a small data pipeline: extract, transform, quality gate, publish. Checks, run history and a SQL console over the published tables." path="/platform/">
  <TopBar />
  <main id="content" class="wrap">
    <header class="intro">
      <p class="label">For engineers</p>
      <h1>How this site is built</h1>
      <p class="sum">
        Every morning a GitHub Action reads my profile file and my GitHub activity, links each skill to its evidence and
        each project number to its source, then runs {blocking} blocking checks. If one fails, nothing is published.
        Below are the live status, the checks of this build, the run history, and a SQL console over the published tables.
      </p>
    </header>
    <Platform />
    <Footer />
  </main>
</Base>

<style>
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 var(--gutter); }
  .intro { padding: clamp(40px, 7vw, 72px) 0 28px; }
  h1 { margin-top: 8px; font-size: clamp(30px, 4.6vw, 44px); font-weight: 700; letter-spacing: -0.03em; }
  .sum { margin-top: 14px; max-width: 70ch; color: var(--ink-2); font-size: 16.5px; }
  .wrap :global(.foot) { margin-top: 64px; }
</style>
