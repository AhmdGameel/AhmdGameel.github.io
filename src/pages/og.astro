---
// Share card source. pipeline/tools/og.mjs screenshots this page at 1200 x 630.
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { person, experience, certifications } from '../lib/data';

const current = experience.find((e) => e.is_current);
const cert = certifications[0];
---

<Base title={`${person.name} share card`} path="/og/" noindex>
  <div class="card">
    <p class="top"><Mark size={40} /><span>ahmdgameel.github.io</span></p>
    <div class="main">
      <h1>{person.name}</h1>
      <p class="role">{person.title}</p>
      <p class="pitch">{person.intro}</p>
    </div>
    <dl class="facts">
      {current && <div><dt>Now</dt><dd>{current.role} at {current.company}</dd></div>}
      <div><dt>Based in</dt><dd>{person.location}</dd></div>
      <div><dt>Certified</dt><dd>{cert.issuer} {cert.name}</dd></div>
    </dl>
  </div>
</Base>

<style>
  :global(body) { margin: 0; }
  .card {
    width: 1200px; height: 630px; padding: 64px 72px;
    display: flex; flex-direction: column; gap: 28px;
    background: #fbfbfa; color: #111318; font-family: var(--sans);
    border-top: 10px solid #1f4fd1;
  }
  .top { display: flex; align-items: center; gap: 14px; margin: 0; font-family: var(--mono); font-size: 20px; color: #4a4f59; }
  .main { margin-top: auto; }
  h1 { font-size: 92px; font-weight: 700; letter-spacing: -0.035em; line-height: 1; }
  .role { margin-top: 10px; font-size: 36px; font-weight: 550; color: #1f4fd1; }
  .pitch { margin-top: 18px; font-size: 24px; line-height: 1.45; color: #4a4f59; max-width: 44ch; }
  .facts { display: flex; gap: 48px; margin: 0; padding-top: 22px; border-top: 1px solid #e7e6e2; }
  .facts dt { font-family: var(--mono); font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase; color: #676c75; }
  .facts dd { margin: 4px 0 0; font-size: 20px; font-weight: 600; }
</style>
